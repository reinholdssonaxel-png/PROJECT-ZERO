      </Item>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">Geometry</string>
          <string name="Source"><![CDATA[--!strict
local Geometry = {}
function Geometry.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Color, p.Material = color, material or Enum.Material.Metal
	p.Anchored = true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
function Geometry.meshWeapon(heroId: string, parent: Instance, preview: boolean?): Model?
	local assets=game.ReplicatedStorage:FindFirstChild("ZeroAssets")
	local art=assets and assets:FindFirstChild("WeaponArt")
	local template=art and art:FindFirstChild(heroId)
	if not template or (heroId=="ATLAS" and not preview) then return nil end
	local sizes={VEX=Vector3.new(.32,.8,2.9),TITAN=Vector3.new(.85,1.15,3.3),PHANTOM=Vector3.new(.25,.62,1.5),HAVOC=Vector3.new(.65,.95,2.3),SPECTRE=Vector3.new(.3,.85,4.2),NOVA=Vector3.new(.35,.75,2.55),ECHO=Vector3.new(.38,.78,2.6),ATLAS=Vector3.new(.95,.85,1.1)}
	local m=template:Clone() m:ClearAllChildren() -- Retain AI provenance on the model.
	m.Name=if heroId=="VEX" then "VX7" else "Weapon_"..heroId
	local receiver=Geometry.part(m,"Receiver",Vector3.one*.1,CFrame.identity,Color3.new()) receiver.Transparency=1
	m.PrimaryPart=receiver
	local center,bounds=template:GetBoundingBox()
	local ratio=sizes[heroId]/bounds
	local function copy(offset: CFrame, hand: string?)
		for _,source in template:GetDescendants() do if source:IsA("MeshPart") then
			local p=source:Clone() p.Name="WeaponMesh"
			local cf=center:ToObjectSpace(source.CFrame)
			p.Size*=ratio p.CFrame=offset*CFrame.new(cf.Position*ratio)*cf.Rotation
			p.Anchored,p.CanCollide,p.CanQuery,p.CanTouch=true,false,false,false
			p:SetAttribute("GripHand",hand) p.Parent=m
		end end
	end
	if heroId=="PHANTOM" or heroId=="ATLAS" then
		for _,sign in {-1,1} do copy(CFrame.new(if preview then sign*.45 else 0,0,-.3),if sign<0 then "Left" else "Right") end
	else copy(CFrame.new(0,-.05,-.45)) end
	local muzzle=Geometry.part(m,"Barrel",Vector3.one*.05,CFrame.new(0,.05,-.45-sizes[heroId].Z/2),Color3.new()) muzzle.Transparency=1
	m.Parent=parent
	return m
end
function Geometry.rifle(parent: Instance): Model
	local mesh=Geometry.meshWeapon("VEX",parent)
	if mesh then return mesh end
	local m = Instance.new("Model")
	m.Name = "VX7"
	local dark, orange = Color3.fromRGB(40, 47, 56), Color3.fromRGB(179, 91, 30)
	local p = Geometry.part
	p(m, "Receiver", Vector3.new(.32, .42, 1.45), CFrame.new(0, 0, -.3), dark)
	p(m, "Barrel", Vector3.new(.13, .13, 1.05), CFrame.new(0, .05, -1.5), dark)
	p(m, "Stock", Vector3.new(.25, .35, .55), CFrame.new(0, 0, .62), dark)
	p(m, "Magazine", Vector3.new(.23, .58, .35), CFrame.new(0, -.43, -.1) * CFrame.Angles(-.18, 0, 0), dark)
	p(m, "Grip", Vector3.new(.22, .48, .25), CFrame.new(0, -.4, .4) * CFrame.Angles(-.2, 0, 0), dark)
	p(m, "Optic", Vector3.new(.19, .17, .3), CFrame.new(0, .29, -.35), orange, Enum.Material.Neon)
	p(m, "HeatStrip", Vector3.new(.335, .05, .85), CFrame.new(0, .1, -.52), orange, Enum.Material.Neon)
	m.PrimaryPart = m.Receiver
	m.Parent = parent
	return m
end
return Geometry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="105">
        <Properties>
          <string name="Name">HeroCatalog</string>
          <string name="Source"><![CDATA[-- Canonical roster. Only VEX has a verified gameplay kit in this milestone.
local function c(r,g,b) return Color3.fromRGB(r,g,b) end
local heroes = {
	TITAN={Role="Tank",HP=700,Name="Viktor Holm",Origin="Sweden / 42",Weapon="M-90 heavy cannon",Primary=c(32,55,87),Accent=c(76,171,255),Scale=1.18,Playable=false,Kit="Shield / Slam",Silhouette="Heavy segmented armor / narrow blue visor"},
	ATLAS={Role="Tank",HP=650,Name="Marcus Cole",Origin="United Kingdom / 36",Weapon="Mechanical gauntlets",Primary=c(177,87,30),Accent=c(255,172,62),Scale=1.13,Playable=false,Kit="Melee / Charge",Silhouette="Industrial exosuit / reinforced gauntlets"},
	VEX={Role="Damage",HP=275,Name="Elias Berg",Origin="Sweden / 29",Weapon="VX-7 assault rifle",Primary=c(39,45,54),Accent=c(255,136,45),Scale=1,Playable=true,Kit="Dash / Pulse Grenade / Overdrive",Silhouette="Charcoal tactical armor / orange visor"},
	PHANTOM={Role="Damage",HP=250,Name="Yuna Takahashi",Origin="Japan / 27",Weapon="Twin pistols",Primary=c(35,29,48),Accent=c(184,107,255),Scale=.96,Playable=false,Kit="Cloak / Shadow Step / Nightfall",Silhouette="Stealth suit / purple lenses / split coat"},
	HAVOC={Role="Damage",HP=300,Name="Daniel Reyes",Origin="United States / 34",Weapon="Grenade launcher",Primary=c(127,45,43),Accent=c(255,101,65),Scale=1.05,Playable=false,Kit="Cluster Bomb / Rocket Jump / Annihilator",Silhouette="Battered red armor / explosive bandolier"},
	SPECTRE={Role="Damage",HP=225,Name="Anton Volkov",Origin="Ukraine / 38",Weapon="Precision rifle",Primary=c(45,56,49),Accent=c(126,238,118),Scale=.99,Playable=false,Kit="Recon Dart / Grapple / Deadeye",Silhouette="Hooded marksman / green optical lenses"},
	NOVA={Role="Support",HP=250,Name="Sofia Lind",Origin="Sweden / 31",Weapon="Energy carbine",Primary=c(201,215,220),Accent=c(72,223,239),Scale=.98,Playable=false,Kit="Healing Drone / Pulse Boost / Revival Field",Silhouette="White medical armor / cyan visor / med pack"},
	ECHO={Role="Support",HP=275,Name="Adrian Moreau",Origin="France / 33",Weapon="Pulse carbine",Primary=c(81,111,142),Accent=c(94,190,255),Scale=1,Playable=false,Kit="Shield Pulse / Disruptor / Amplify",Silhouette="Layered tech armor / holographic shield emitters"},
}
for _,h in heroes do table.freeze(h) end
return table.freeze({Order=table.freeze({"TITAN","ATLAS","VEX","PHANTOM","HAVOC","SPECTRE","NOVA","ECHO"}),Heroes=table.freeze(heroes)})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="106">
        <Properties>
          <string name="Name">HeroStyle</string>
          <string name="Source"><![CDATA[local G = require(script.Parent.Geometry)
local Catalog = require(script.Parent.HeroCatalog)
local Weapons = require(script.Parent.HeroWeapons)
local Style = {}
function Style.decorate(m, heroId, faction)
	local h = Catalog.Heroes[heroId]
	local primary, accent = h.Primary, h.Accent
	local dark, metal = Color3.fromRGB(26,32,39), Color3.fromRGB(94,106,118)
	for _,p in m:GetChildren() do if p:IsA("BasePart") then p.Color=primary end end
	-- Human skin under a fitted mask/helmet, rather than a robotic replacement head.
	m.Head.Color=Color3.fromRGB(179,141,116)
	local function attach(name,body,size,offset,color,mat)
		local limb=m[body]
		local p=G.part(m,name,size,limb.CFrame*offset,color or primary,mat)
		p.Anchored,p.CanCollide,p.CanQuery,p.CanTouch,p.Massless=false,false,false,false,true
		local w=Instance.new("WeldConstraint") w.Part0,w.Part1,w.Parent=limb,p,p
		return p
	end
	local function plate(name,body,size,pos,color,mat) return attach(name,body,size,CFrame.new(pos),color,mat) end
	local bulk=if heroId=="TITAN" then 1.3 elseif heroId=="ATLAS" then 1.15 else 1
	plate("ChestArmor","UpperTorso",Vector3.new(1.9*bulk,.9,.28),Vector3.new(0,.05,-.58))
	plate("AbdominalPlate","LowerTorso",Vector3.new(1.55,.5,.22),Vector3.new(0,0,-.53),dark)
	plate("Backpack","UpperTorso",Vector3.new(1.3,1.1,.5),Vector3.new(0,0,.7),dark)
	for _,side in {"Left","Right"} do
		local sign=if side=="Left" then -1 else 1
		plate("Pauldron"..side,side.."UpperArm",Vector3.new(.9*bulk,.5,1),Vector3.new(sign*.06,.35,0))
		plate("ForearmGuard"..side,side.."LowerArm",Vector3.new(.7,.75,.78),Vector3.new(0,0,0),dark)
		plate("Kneepad"..side,side.."LowerLeg",Vector3.new(.78,.45,.2),Vector3.new(0,.35,-.47),metal)
		plate("Boot"..side,side.."Foot",Vector3.new(.83,.45,1.14),Vector3.zero,dark)
		plate("SuitTrim"..side,side.."UpperArm",Vector3.new(.15,.32,.08),Vector3.new(sign*.3,.35,-.53),accent,Enum.Material.Neon)
	end
	local shell=plate("HelmetShell","Head",Vector3.new(1.3,1.05,1.3),Vector3.new(0,.2,.02),dark)
	plate("Mask","Head",Vector3.new(1.13,.5,.18),Vector3.new(0,-.25,-.61),primary)
	local visorColor=Color3.new(accent.R*.65,accent.G*.65,accent.B*.65)
	local visor=plate("Visor","Head",Vector3.new(1.18,.16,.12),Vector3.new(0,.15,-.68),visorColor,Enum.Material.Neon)
	-- Reviewed Creator Store helmet mesh is only a base shell; recolored and augmented.
	local template=game.ReplicatedStorage:FindFirstChild("ZeroAssets") and game.ReplicatedStorage.ZeroAssets:FindFirstChild("HelmetReference")
	if template and (heroId=="VEX" or heroId=="TITAN" or heroId=="ECHO") then
		local source=template:FindFirstChild("Handle")
		if source then
			local helmet=source:Clone() helmet.Name="AdaptedHelmet"
			helmet.CFrame=m.Head.CFrame*CFrame.new(0,.1,0) helmet.Anchored=false helmet.Massless=true
			helmet.CanCollide,helmet.CanQuery,helmet.CanTouch=false,false,false helmet.Color=primary
			local mesh=helmet:FindFirstChildOfClass("SpecialMesh")
			if mesh then mesh.TextureId="" mesh.Scale*=1.05 end
			local w=Instance.new("WeldConstraint") w.Part0,w.Part1,w.Parent=m.Head,helmet,helmet helmet.Parent=m shell.Color=primary
		end
	end
	if heroId=="TITAN" then
		visor.Size=Vector3.new(1.1,.1,.13)
		plate("Collar","UpperTorso",Vector3.new(2.45,.35,1.4),Vector3.new(0,.65,0),metal)
		for _,x in {-.5,.5} do plate("CannonCell","UpperTorso",Vector3.new(.3,.8,.28),Vector3.new(x,.05,-.81),accent,Enum.Material.Neon) end
	elseif heroId=="ATLAS" then
		for _,side in {"Left","Right"} do
			plate("ExoForearm"..side,side.."LowerArm",Vector3.new(1,.8,1),Vector3.zero,primary)
			plate("DrivePiston"..side,side.."UpperLeg",Vector3.new(.22,1.05,.25),Vector3.new(.48,0,.2),metal)
			plate("PoweredGauntlet"..side,side.."Hand",Vector3.new(1.15,.7,1.2),Vector3.new(0,-.1,-.1),primary)
		end
		plate("ExoSpine","UpperTorso",Vector3.new(.6,1.7,.5),Vector3.new(0,.2,.95),accent)
	elseif heroId=="PHANTOM" then
		shell.Color=primary visor.Transparency=1
		for _,x in {-.3,.3} do plate("StealthLens","Head",Vector3.new(.27,.16,.12),Vector3.new(x,.12,-.7),accent,Enum.Material.Neon) end
		for _,x in {-.48,.48} do plate("SplitCoat","LowerTorso",Vector3.new(.8,1.5,.14),Vector3.new(x,-.7,.55),dark,Enum.Material.Fabric) end
	elseif heroId=="HAVOC" then
		for n=1,4 do
			attach("GrenadeBandolier","UpperTorso",Vector3.new(.23,.4,.28),CFrame.new(-.65+n*.26,.6-n*.2,-.8)*CFrame.Angles(0,0,-.6),metal)
		end
		plate("BlastShield","LeftUpperArm",Vector3.new(1.1,.9,1.1),Vector3.new(-.12,.15,0),dark)
		plate("ArmorScar","UpperTorso",Vector3.new(.6,.06,.04),Vector3.new(.45,.3,-.74),metal)
	elseif heroId=="SPECTRE" then
		shell.Color=primary shell.Material=Enum.Material.Fabric
		plate("HoodBack","Head",Vector3.new(1.4,1.55,.3),Vector3.new(0,-.1,.65),dark,Enum.Material.Fabric)
		for _,x in {-.72,.72} do plate("HoodSide","Head",Vector3.new(.18,1.5,1.3),Vector3.new(x,-.05,0),dark,Enum.Material.Fabric) end
		visor.Size=Vector3.new(.35,.28,.2) visor.CFrame=m.Head.CFrame*CFrame.new(-.3,.15,-.73)
		plate("OpticalLens","Head",Vector3.new(.35,.28,.2),Vector3.new(.3,.15,-.73),accent,Enum.Material.Neon)
		plate("ReconAntenna","UpperTorso",Vector3.new(.08,1.8,.08),Vector3.new(.5,1,.8),metal)
	elseif heroId=="NOVA" then
		shell.Color=primary
		plate("MedicalPack","UpperTorso",Vector3.new(1.4,1.3,.4),Vector3.new(0,0,1),primary)
		plate("MedicalCrossH","UpperTorso",Vector3.new(.65,.16,.08),Vector3.new(0,.1,-.76),accent,Enum.Material.Neon)
		plate("MedicalCrossV","UpperTorso",Vector3.new(.16,.65,.08),Vector3.new(0,.1,-.77),accent,Enum.Material.Neon)
		for _,x in {-.7,.7} do plate("MedCanister","UpperTorso",Vector3.new(.3,.8,.3),Vector3.new(x,0,.9),accent) end
	elseif heroId=="ECHO" then
		for _,side in {"Left","Right"} do
			local panel=plate("HologramEmitter"..side,side.."LowerArm",Vector3.new(.13,.8,1.3),Vector3.new(if side=="Left" then -.5 else .5,0,0),accent,Enum.Material.Neon)
			panel.Transparency=.45
		end
		plate("ProjectionCore","UpperTorso",Vector3.new(.5,.5,.2),Vector3.new(0,.05,-.8),accent,Enum.Material.Neon)
	else
		for _,x in {-.62,0,.62} do plate("MagazinePouch","UpperTorso",Vector3.new(.4,.55,.2),Vector3.new(x,-.25,-.78),dark) end
	end
	local stripe=plate("TeamStripe","UpperTorso",Vector3.new(1.45,.08,.08),Vector3.new(0,.48,-.78),if faction=="Alpha" then Color3.fromRGB(75,211,240) else Color3.fromRGB(255,121,64),Enum.Material.Neon)
	local gun=Weapons.create(heroId,m)
	gun:PivotTo(m.RightHand.CFrame*CFrame.new(0,-.1,-.9))
	for _,p in gun:GetDescendants() do if p:IsA("BasePart") then
		p.Anchored,p.CanCollide,p.CanQuery,p.CanTouch,p.Massless=false,false,false,false,true
		local hand=if p:GetAttribute("GripHand")=="Left" then m.LeftHand else m.RightHand
		if hand==m.LeftHand then p.CFrame=hand.CFrame*m.RightHand.CFrame:ToObjectSpace(p.CFrame) end
		local w=Instance.new("WeldConstraint") w.Part0,w.Part1,w.Parent=hand,p,p
	end end
	m:SetAttribute("WeaponName",h.Weapon)
end
return Style
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">HeroWeapons</string>
          <string name="Source"><![CDATA[local G = require(script.Parent.Geometry)
local Catalog = require(script.Parent.HeroCatalog)
local Weapons = {}
function Weapons.create(heroId, parent, preview)
	local hero = Catalog.Heroes[heroId]
	if heroId == "VEX" then return G.rifle(parent) end
	local mesh=G.meshWeapon(heroId,parent,preview)
	if mesh then return mesh end
	local m = Instance.new("Model") m.Name = "Weapon_" .. heroId
	local metal, dark, accent = Color3.fromRGB(90,103,116), Color3.fromRGB(31,38,45), hero.Accent
	local function p(name,size,pos,color,mat)
		return G.part(m,name,size,CFrame.new(pos),color or dark,mat)
	end
	local root=p("Receiver",Vector3.new(.32,.4,1.3),Vector3.zero)
	m.PrimaryPart=root
	if heroId=="ATLAS" then
		root.Transparency=1
		-- The two powered gauntlets are fitted directly to LeftHand/RightHand by HeroStyle.
		if preview then
			for _,x in {-.75,.75} do
				p("Gauntlet",Vector3.new(.9,.8,1.1),Vector3.new(x,0,0),hero.Primary)
				p("PowerRail",Vector3.new(.35,.15,.8),Vector3.new(x,.5,0),accent,Enum.Material.Neon)
			end
		end
	elseif heroId=="PHANTOM" then
		root.Transparency=1
		for _,x in {-.4,.4} do
			p("PistolSlide",Vector3.new(.25,.28,1.1),Vector3.new(x,.05,-.25))
			p("PistolGrip",Vector3.new(.22,.6,.3),Vector3.new(x,-.35,.05))
			p("SuppressedBarrel",Vector3.new(.2,.2,.5),Vector3.new(x,.03,-1),metal)
			p("PistolSight",Vector3.new(.08,.06,.3),Vector3.new(x,.22,-.35),accent,Enum.Material.Neon)
		end
		for _,part in m:GetChildren() do if part:IsA("BasePart") and part~=root then part:SetAttribute("GripHand",if part.Position.X<0 then "Left" else "Right") end end
	elseif heroId=="TITAN" then
		root.Size=Vector3.new(.7,.65,1.6) root.Color=hero.Primary
		for _,x in {-.2,.2} do for _,y in {-.16,.16} do p("CannonBarrel",Vector3.new(.2,.2,1.8),Vector3.new(x,y,-1.35),metal) end end
		p("Drum",Vector3.new(.95,.8,.8),Vector3.new(0,-.6,.15),metal)
		p("TopRail",Vector3.new(.18,.1,1.6),Vector3.new(0,.4,-.2),accent,Enum.Material.Neon)
	elseif heroId=="HAVOC" then
		root.Color=hero.Primary
		local drum=p("GrenadeDrum",Vector3.new(.8,.9,.9),Vector3.new(0,-.3,0),metal) drum.Shape=Enum.PartType.Ball
		p("WideMuzzle",Vector3.new(.5,.5,.85),Vector3.new(0,.1,-1.1),metal)
		p("MuzzleOpening",Vector3.new(.3,.3,.03),Vector3.new(0,.1,-1.54),dark)
		p("WarningStripe",Vector3.new(.34,.08,.8),Vector3.new(0,.3,-.6),accent)
	elseif heroId=="SPECTRE" then
		p("LongBarrel",Vector3.new(.12,.12,2.3),Vector3.new(0,.05,-1.7),metal)
		p("Scope",Vector3.new(.27,.3,.85),Vector3.new(0,.45,-.2))
		p("ScopeLens",Vector3.new(.24,.24,.03),Vector3.new(0,.45,-.64),accent,Enum.Material.Neon)
		p("PrecisionStock",Vector3.new(.26,.45,.8),Vector3.new(0,-.05,.9),hero.Primary)
		p("Bolt",Vector3.new(.28,.12,.15),Vector3.new(.26,0,.15),metal)
	else
		root.Color=hero.Primary
		p("EnergyBarrel",Vector3.new(.22,.22,1.2),Vector3.new(0,.05,-1.15),metal)
		for _,x in {-.23,.23} do p("EnergyRail",Vector3.new(.08,.16,1.35),Vector3.new(x,.05,-.5),accent,Enum.Material.Neon) end
		p("Cell",Vector3.new(.26,.65,.3),Vector3.new(0,-.4,.2),accent,Enum.Material.Neon)
		p("Optic",Vector3.new(.2,.15,.3),Vector3.new(0,.3,-.2),accent,Enum.Material.Neon)
	end
	if heroId~="ATLAS" and heroId~="PHANTOM" then p("Grip",Vector3.new(.23,.55,.28),Vector3.new(0,-.4,.4)) end
	m.Parent=parent
	return m
end
return Weapons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="108">
        <Properties>
          <string name="Name">MapLayout</string>
          <string name="Source"><![CDATA[local Layout = {Version=2, WalkSpeed=22, CombatLimit=92}
function Layout.side(faction) return if faction=="Alpha" then -1 else 1 end
function Layout.spawnPosition(faction) return Vector3.new(0,1.5,Layout.side(faction)*230) end
function Layout.isSafe(p)
	return math.abs(p.X)<=126 and math.abs(p.Z)>=184 and math.abs(p.Z)<=252 and p.Y<32
end
function Layout.inCombatArea(p)
	return math.abs(p.Z)<=Layout.CombatLimit and math.abs(p.X)<150 and p.Y<30
end
function Layout.route(faction,exit)
	local s,x=Layout.side(faction),if exit==1 then -1 else 1
	local points={{42,212},{42,198},{96,198},{96,148},{48,148},{48,96},{36,68},{36,22},{0,0}}
	local result={}
	for _,p in points do table.insert(result,Vector3.new(p[1]*x,3,p[2]*s)) end
	return result
end
function Layout.exitSamples(faction)
	local s=Layout.side(faction)
	return {Vector3.new(-42,5.5,210*s),Vector3.new(42,5.5,210*s),Vector3.new(-42,5.5,198*s),Vector3.new(42,5.5,198*s),Vector3.new(-96,5.5,194*s),Vector3.new(96,5.5,194*s),Vector3.new(-96,5.5,156*s),Vector3.new(96,5.5,156*s)}
end
return table.freeze(Layout)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">MeshHeroStyle</string>
          <string name="Source"><![CDATA[local G=require(script.Parent.Geometry)
local Catalog=require(script.Parent.HeroCatalog)
local Fit=require(script.Parent.ArmorFit)
local Weapons=require(script.Parent.HeroWeapons)
local Style={}
-- Distinct meshes and fitted proportions; shared limb shells are modular equipment.
local shapes={
 TITAN={chest=Vector3.new(2.7,1.55,1.6),helmet=Vector3.new(1.55,1.5,1.55),shoulder=1.4,arm=1.18,leg=1.2},
 ATLAS={chest=Vector3.new(2.15,1.35,1.45),helmet=Vector3.new(1.4,1.4,1.4),shoulder=1.1,arm=1.3,leg=1.1},
 VEX={chest=Vector3.new(2.08,1.3,1.28),helmet=Vector3.new(1.32,1.38,1.35),shoulder=.9,arm=1,leg=1},
 PHANTOM={chest=Vector3.new(1.85,1.25,1.15),helmet=Vector3.new(1.28,1.35,1.3),shoulder=.68,arm=.86,leg=.9},
 HAVOC={chest=Vector3.new(2.35,1.5,1.45),helmet=Vector3.new(1.48,1.35,1.48),shoulder=1.15,arm=1.15,leg=1.1},
 SPECTRE={chest=Vector3.new(1.95,1.35,1.22),helmet=Vector3.new(1.4,1.55,1.45),shoulder=.65,arm=.9,leg=.9},
 NOVA={chest=Vector3.new(1.95,1.3,1.25),helmet=Vector3.new(1.3,1.4,1.35),shoulder=.8,arm=.95,leg=.95},
 ECHO={chest=Vector3.new(2.05,1.35,1.3),helmet=Vector3.new(1.35,1.4,1.4),shoulder=.85,arm=1,leg=1},
}
function Style.decorate(m,id,faction)
 local assets=game.ReplicatedStorage:FindFirstChild("ZeroAssets")
 local art=assets and assets:FindFirstChild("HeroArt")
 local kit=art and art:FindFirstChild(id)
 if not kit or not kit:FindFirstChild("Helmet") or not kit:FindFirstChild("Chest") then
  require(script.Parent.HeroStyle).decorate(m,id,faction) m:SetAttribute("ArtStatus","FALLBACK") return
 end
 local h,s=Catalog.Heroes[id],shapes[id]
 local dark,metal=Color3.fromRGB(25,30,37),Color3.fromRGB(110,123,132)
 for _,p in m:GetChildren() do if p:IsA("BasePart") then p.Color=dark p.Material=Enum.Material.Fabric end end
 m.Head.Color=Color3.fromRGB(179,141,116) m.Head.Material=Enum.Material.SmoothPlastic
 local function attach(name,body,size,cf,color,material)
  local p=G.part(m,name,size,m[body].CFrame*cf,color or h.Primary,material or Enum.Material.Metal)
  p.Anchored,p.Massless,p.CanCollide,p.CanQuery,p.CanTouch=false,true,false,false,false
  p:SetAttribute("ArmorLimb",body)
  local w=Instance.new("WeldConstraint") w.Name,w.Part0,w.Part1,w.Parent="ArmorMount",m[body],p,p
  return p
 end
 local function plate(name,body,size,pos,color,mat) return attach(name,body,size,CFrame.new(pos),color,mat) end
 -- Keep the original server hit volumes while fitting a slimmer human undersuit
 -- inside hollow armor. The visible suit must not fill the plate's hollow interior.
 local narrow=if id=="PHANTOM" or id=="NOVA" then .84 elseif id=="TITAN" then 1 else .92
 for _,body in m:GetChildren() do if body:IsA("MeshPart") then
  local suit=body:Clone() suit:ClearAllChildren() suit.Name="Undersuit_"..body.Name suit.Size*=Vector3.new(narrow,.98,.65)
  suit.Color=if id=="NOVA" then Color3.fromRGB(145,158,168) elseif id=="TITAN" or id=="ECHO" or id=="SPECTRE" then h.Primary:Lerp(dark,.35) else dark
  suit.CanCollide,suit.CanQuery,suit.CanTouch,suit.Massless=false,false,false,true
  suit:SetAttribute("ArmorLimb",body.Name)
  local w=Instance.new("WeldConstraint") w.Name,w.Part0,w.Part1,w.Parent="ArmorMount",body,suit,suit
  suit.Parent=m body.Transparency=1
 end end
 Fit.equip(kit.Helmet,m,"Head","MeshHelmet",s.helmet,CFrame.new(0,.05,0))
 Fit.equip(kit.Chest,m,"UpperTorso","MeshCuirass",s.chest,CFrame.new(0,-.03,-.12))
 local common=art:FindFirstChild("Common")
 for _,side in {"Left","Right"} do
  local sign=if side=="Left" then -1 else 1
  for _,d in {{"Shoulder","UpperArm",Vector3.new(.95,.65,1.05)*s.shoulder,CFrame.new(sign*.06,.28,0)},
   {"Forearm","LowerArm",Vector3.new(.72,.9,.78)*s.arm,CFrame.identity},
   {"Shin","UpperLeg",Vector3.new(.76,.7,.22)*s.leg,CFrame.new(0,-.05,-.43)},
   {"Shin","LowerLeg",Vector3.new(.8,.9,.3)*s.leg,CFrame.new(0,0,-.42)}} do
   if common and common:FindFirstChild(d[1]) then
    local group=Fit.equip(common[d[1]],m,side..d[2],d[1]..side..d[2],d[3],d[4])
    for _,p in group:GetDescendants() do if p:IsA("MeshPart") then p.TextureID="" p.Color=h.Primary:Lerp(Color3.new(1,1,1),.12) p.Material=Enum.Material.Metal end end
   end
  end
  plate("SuitSeam"..side,side.."UpperArm",Vector3.new(.08,.35,.06),Vector3.new(sign*.34,0,-.4),h.Accent)
 end
 local visor=plate("Visor","Head",Vector3.new(1.1,.11,.05),Vector3.new(0,.16,-s.helmet.Z/2-.02),h.Accent:Lerp(Color3.new(),.25),Enum.Material.Neon)
 if id=="VEX" or id=="PHANTOM" then plate("TacticalRespirator","Head",Vector3.new(.96,.42,.13),Vector3.new(0,-.22,-.62),dark) end
 if id=="TITAN" then
  visor.Size=Vector3.new(1.1,.075,.05)
  plate("BlastCollar","UpperTorso",Vector3.new(2.6,.28,1.5),Vector3.new(0,.65,0),h.Primary)
  for _,x in {-.5,.5} do plate("CannonCell","UpperTorso",Vector3.new(.25,.75,.3),Vector3.new(x,0,.9),h.Accent) end
 elseif id=="ATLAS" then
  for _,side in {"Left","Right"} do
   local sign=if side=="Left" then -1 else 1
   local gauntlet=assets:FindFirstChild("WeaponArt") and assets.WeaponArt:FindFirstChild("ATLAS")
   if gauntlet then Fit.equip(gauntlet,m,side.."Hand","PoweredGauntlet"..side,Vector3.new(1.12,.8,1.15),CFrame.new(0,-.1,-.1))
   else plate("PoweredGauntlet"..side,side.."Hand",Vector3.new(1.12,.7,1.15),Vector3.new(0,-.1,-.1),h.Primary) end
   for _,limb in {"UpperArm","UpperLeg","LowerLeg"} do
    local p=attach("Hydraulic"..side..limb,side..limb,Vector3.new(.85,.14,.14),CFrame.new(sign*.45,0,.15)*CFrame.Angles(0,0,math.pi/2),metal) p.Shape=Enum.PartType.Cylinder
   end
  end
  plate("HydraulicPowerUnit","UpperTorso",Vector3.new(.7,1.5,.5),Vector3.new(0,.1,.85),h.Primary)
 elseif id=="PHANTOM" then
  visor.Size=Vector3.new(.7,.07,.06)
  for _,x in {-.48,.48} do plate("SplitCoat","LowerTorso",Vector3.new(.62,1.35,.12),Vector3.new(x,-.65,.5),dark,Enum.Material.Fabric) end
 elseif id=="HAVOC" then
  for n=1,4 do local p=attach("GrenadeBandolier","UpperTorso",Vector3.new(.42,.22,.22),CFrame.new(-.65+n*.27,.55-n*.2,-.8)*CFrame.Angles(0,0,math.pi/2-.5),metal) p.Shape=Enum.PartType.Cylinder end
  plate("BlastShield","LeftUpperArm",Vector3.new(.9,.85,.28),Vector3.new(0,0,-.55),h.Primary)
 elseif id=="SPECTRE" then
  visor.Transparency=1
  for _,x in {-.28,.28} do local p=plate("OpticalLens","Head",Vector3.new(.23,.23,.07),Vector3.new(x,.15,-.76),h.Accent,Enum.Material.Neon) p.Shape=Enum.PartType.Ball end
  plate("ReconAntenna","UpperTorso",Vector3.new(.045,1.5,.045),Vector3.new(.55,.8,.8),metal)
 elseif id=="NOVA" then
  plate("MedicalPack","UpperTorso",Vector3.new(1.15,1.15,.45),Vector3.new(0,0,.85),h.Primary)
  for _,sign in {-1,1} do attach("MedicChevron","UpperTorso",Vector3.new(.45,.09,.05),CFrame.new(sign*.16,.1,-.71)*CFrame.Angles(0,0,sign*.7),h.Accent,Enum.Material.Neon) end
  for _,x in {-.65,.65} do local p=attach("OxygenCylinder","UpperTorso",Vector3.new(.8,.25,.25),CFrame.new(x,0,.85)*CFrame.Angles(0,0,math.pi/2),metal) p.Shape=Enum.PartType.Cylinder end
 elseif id=="ECHO" then
  for _,side in {"Left","Right"} do local p=plate("HologramEmitter"..side,side.."LowerArm",Vector3.new(.035,.7,1.05),Vector3.new(if side=="Left" then -.5 else .5,0,0),h.Accent,Enum.Material.Neon) p.Transparency=.6 end
  plate("ProjectionCore","UpperTorso",Vector3.new(.3,.3,.06),Vector3.new(0,.1,-.72),h.Accent,Enum.Material.Neon).Shape=Enum.PartType.Ball
 end
 plate("TeamStripe","UpperTorso",Vector3.new(1.3,.055,.045),Vector3.new(0,.48,-s.chest.Z/2-.03),if faction=="Alpha" then Color3.fromRGB(75,211,240) else Color3.fromRGB(255,121,64),Enum.Material.Neon)
 local gun=Weapons.create(id,m) gun:PivotTo(m.RightHand.CFrame*CFrame.Angles(-1.3,0,0)*CFrame.new(0,.2,-.4))
 for _,p in gun:GetDescendants() do if p:IsA("BasePart") then
  p.Anchored,p.CanCollide,p.CanQuery,p.CanTouch,p.Massless=false,false,false,false,true
  local hand=if p:GetAttribute("GripHand")=="Left" then m.LeftHand else m.RightHand
  if hand==m.LeftHand then p.CFrame=hand.CFrame*m.RightHand.CFrame:ToObjectSpace(p.CFrame) end
  local w=Instance.new("WeldConstraint") w.Part0,w.Part1,w.Parent=hand,p,p
 end end
 m:SetAttribute("WeaponName",h.Weapon) m:SetAttribute("ArtStatus","MESH")
end
return Style
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">RigFactory</string>
          <string name="Source"><![CDATA[local C = require(script.Parent.Config)
local G = require(script.Parent.Geometry)
local Catalog = require(script.Parent.HeroCatalog)
local Style = require(script.Parent.MeshHeroStyle)
local Factory = {}
function Factory.create(name, faction, position, heroId)
 heroId = heroId or "VEX"
 local hero = assert(Catalog.Heroes[heroId], "Unknown hero")
	local m = Instance.new("Model")
	m.Name = name
	m:SetAttribute("Faction", faction)
	m:SetAttribute("Hero", heroId)
	local dark = Color3.fromRGB(38, 43, 51)
	local pieces = {
		{"HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3.1, 0)},
		{"LowerTorso", Vector3.new(1.8, .6, .9), Vector3.new(0, 2.8, 0), "HumanoidRootPart"},
		{"UpperTorso", Vector3.new(2, 1.2, 1), Vector3.new(0, 3.7, 0), "LowerTorso"},
		{"Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.9, 0), "UpperTorso"},
	}
	for _, side in {"Left", "Right"} do
		local s = if side == "Left" then -1 else 1
		table.insert(pieces, {side .. "UpperArm", Vector3.new(.65, 1.1, .7), Vector3.new(s * 1.35, 3.7, 0), "UpperTorso"})
		table.insert(pieces, {side .. "LowerArm", Vector3.new(.6, 1, .65), Vector3.new(s * 1.35, 2.65, 0), side .. "UpperArm"})
		table.insert(pieces, {side .. "Hand", Vector3.new(.6, .4, .65), Vector3.new(s * 1.35, 1.95, 0), side .. "LowerArm"})
		table.insert(pieces, {side .. "UpperLeg", Vector3.new(.8, 1, .85), Vector3.new(s * .5, 2, 0), "LowerTorso"})
		table.insert(pieces, {side .. "LowerLeg", Vector3.new(.75, 1, .8), Vector3.new(s * .5, 1, 0), side .. "UpperLeg"})
		table.insert(pieces, {side .. "Foot", Vector3.new(.8, .5, 1.1), Vector3.new(s * .5, .25, -.15), side .. "LowerLeg"})
	end
	local origin = CFrame.new(position)
	for _, data in pieces do
		local assets = game.ReplicatedStorage:FindFirstChild("ZeroAssets")
		local body = assets and assets:FindFirstChild("HumanBody")
		local source = body and body:FindFirstChild(data[1])
		local p
		if source then
			p = source:Clone()
			p.Size, p.CFrame, p.Color = data[2], origin * CFrame.new(data[3]), dark
			p.Parent = m
		else
			p = G.part(m, data[1], data[2], origin * CFrame.new(data[3]), dark)
			if data[1] == "Head" then
				local mesh = Instance.new("SpecialMesh") mesh.MeshType = Enum.MeshType.Head mesh.Parent = p
			end
		end
		p.Anchored = false
		p.CanCollide = data[1] == "UpperTorso" or data[1] == "LowerTorso"
		p.Massless = data[1] ~= "HumanoidRootPart"
		if data[1] == "HumanoidRootPart" then p.Transparency = 1 end
		if data[4] then
			local parent = m[data[4]]
			local joint = Instance.new("Motor6D")
			joint.Name, joint.Part0, joint.Part1 = data[1] .. "Joint", parent, p
			joint.C0 = parent.CFrame:ToObjectSpace(p.CFrame)
			-- Place limb pivots at shoulders/elbows/hips/knees instead of their centers.
			if data[1]:find("Arm") or data[1]:find("Leg") or data[1]:find("Hand") then
				joint.C1 = CFrame.new(0,p.Size.Y/2,0)
				joint.C0 *= joint.C1
			end
			joint.Parent = parent
		end
	end
	local h = Instance.new("Humanoid")
	h.RigType, h.MaxHealth, h.Health, h.WalkSpeed, h.HipHeight = Enum.HumanoidRigType.R15, hero.HP, hero.HP, C.WalkSpeed, 2.1
	h.DisplayName, h.BreakJointsOnDeath = heroId, false
	h.Parent = m
	Instance.new("Animator", h)
	Style.decorate(m, heroId, faction)
	m.PrimaryPart = m.HumanoidRootPart
	m:ScaleTo(hero.Scale)
	return m
end

return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="111">
        <Properties>
          <string name="Name">WeaponRules</string>
          <string name="Source"><![CDATA[--!strict
local Rules = {}
function Rules.finiteNumber(n: any): boolean
	return type(n) == "number" and n == n and math.abs(n) < math.huge
end
function Rules.direction(v: any): boolean
	return typeof(v) == "Vector3" and Rules.finiteNumber(v.X)
		and Rules.finiteNumber(v.Y) and Rules.finiteNumber(v.Z)
		and v.Magnitude > 0.95 and v.Magnitude < 1.05
end
function Rules.canFire(state: any, now: number, interval: number): boolean
	return state.ammo > 0 and state.reloadEnd == 0 and now - state.lastShot >= interval
end
function Rules.enemy(a: Model, b: Model): boolean
	return a ~= b and a:GetAttribute("Faction") ~= nil
		and b:GetAttribute("Faction") ~= nil and a:GetAttribute("Faction") ~= b:GetAttribute("Faction")
end
return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="112">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="113">
      <Properties>
        <string name="Name">ZeroServer</string>
      </Properties>
      <Item class="ModuleScript" referent="114">
        <Properties>
          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[local Lighting=game:GetService("Lighting")
local G=require(game.ReplicatedStorage.ZeroShared.Geometry)
local Layout=require(game.ReplicatedStorage.ZeroShared.MapLayout)
local Arena={}
function Arena.build()
 local old=workspace:FindFirstChild("ZeroArena") if old then old:Destroy() end
 local arena=Instance.new("Folder") arena.Name="ZeroArena" arena.Parent=workspace arena:SetAttribute("LayoutVersion",2)
 local steel,dark,brick=Color3.fromRGB(78,94,107),Color3.fromRGB(38,48,59),Color3.fromRGB(111,76,66)
 local doors={}
 local function box(name,size,pos,color,mat)
  local p=G.part(arena,name,size,CFrame.new(pos),color or steel,mat or Enum.Material.Concrete) p.CanTouch=false return p
 end
 box("Quay",Vector3.new(320,3,520),Vector3.new(0,-1.5,0),dark,Enum.Material.Asphalt).Reflectance=.12
 local sea=box("HarborWater",Vector3.new(1100,2,1100),Vector3.new(0,-6,0),Color3.fromRGB(27,62,80),Enum.Material.Glass) sea.CanCollide=false sea.CanQuery=false sea.Reflectance=.2
 for _,x in {-159,159} do
  box("QuayBoundary",Vector3.new(2,5,520),Vector3.new(x,2.5,0),steel)
  local p=box("HarborBoundary",Vector3.new(2,60,520),Vector3.new(x,30,0)) p.Transparency=1 p.CanQuery=false
 end
 for _,z in {-259,259} do
  local p=box("HarborBoundary",Vector3.new(320,60,2),Vector3.new(0,30,z)) p.Transparency=1 p.CanQuery=false
  box("Seawall",Vector3.new(320,2,3),Vector3.new(0,1,z),steel)
 end
 -- Equal circulation footprints; different cladding and service identities.
 for _,s in {-1,1} do
  local faction=if s==-1 then "Alpha" else "Bravo"
  local skin=if s==-1 then brick else steel
  local mat=if s==-1 then Enum.Material.Brick else Enum.Material.Metal
  box(faction.."RoomFloor",Vector3.new(132,1,40),Vector3.new(0,.5,s*232),steel,Enum.Material.DiamondPlate)
  box(faction.."RoomRoof",Vector3.new(136,2,42),Vector3.new(0,25,s*232),dark)
  for _,x in {-66,66} do box("RoomSide",Vector3.new(2,25,40),Vector3.new(x,12.5,s*232),skin,mat) end
  box("WindowSill",Vector3.new(132,4,2),Vector3.new(0,2,s*252),skin,mat)
  local glass=box(faction.."PanoramicWindow",Vector3.new(130,18,1),Vector3.new(0,13,s*252),Color3.fromRGB(123,172,188),Enum.Material.Glass) glass.Transparency=.65
  box("WindowHeader",Vector3.new(132,3,2),Vector3.new(0,23.5,s*252),skin,mat)
  for _,x in {-44,0,44} do box("WindowMullion",Vector3.new(.5,20,2),Vector3.new(x,14,s*252),dark,Enum.Material.Metal) end
  for _,d in {{-58.5,15},{0,66},{58.5,15}} do box("RoomFront",Vector3.new(d[2],25,3),Vector3.new(d[1],12.5,s*212),skin,mat) end
  for _,x in {-42,42} do
   box("DoorHeader",Vector3.new(18,10,3),Vector3.new(x,20,s*212),skin,mat)
   local d=box(faction..(if x<0 then "WestDoor" else "EastDoor"),Vector3.new(18,15,1),Vector3.new(x,7.5,s*212),dark,Enum.Material.Metal)
   d:SetAttribute("ClosedCFrame",d.CFrame) table.insert(doors,d)
  end
  -- Split vestibules terminate at a real roofed cross-dock, forcing two turns.
  box("VestibuleDivider",Vector3.new(3,28,26),Vector3.new(0,14,s*198),skin,mat)
  box("CrossDock",Vector3.new(152,32,26),Vector3.new(0,16,s*172),skin,mat)
  box("VestibuleCanopy",Vector3.new(250,2,28),Vector3.new(0,28,s*198),dark,Enum.Material.Metal)
  for _,x in {-142,142} do box("ServiceWarehouse",Vector3.new(32,32,74),Vector3.new(x,16,s*177),skin,mat) end
  for _,x in {-98,98} do box("WorkshopGatehouse",Vector3.new(64,32,26),Vector3.new(x,16,s*123),skin,mat) end
  box("TransferOffice",Vector3.new(42,26,16),Vector3.new(0,13,s*110),skin,mat)
  box("DispatchHouse",Vector3.new(36,24,22),Vector3.new(0,12,s*42),skin,mat)
  local spawn=Instance.new("SpawnLocation") spawn.Name=faction.."Spawn" spawn.Size=Vector3.new(10,1,10) spawn.CFrame=CFrame.new(Layout.spawnPosition(faction)) spawn.Anchored=true spawn.Transparency=1 spawn.CanCollide=false spawn.CanQuery=false spawn.Duration=0 spawn.Parent=arena
 end
 -- West warehouse: two side portals and alternating fire compartments.
 box("WestWarehouseFloor",Vector3.new(78,.3,168),Vector3.new(-103,.15,0),steel)
 box("WestOuterWall",Vector3.new(3,28,168),Vector3.new(-143,14,0),brick,Enum.Material.Brick)
 box("WestWarehouseRoof",Vector3.new(82,2,172),Vector3.new(-103,29,0),dark,Enum.Material.Metal)
 for _,z in {-66,0,66} do box("WestInnerWall",Vector3.new(3,28,36),Vector3.new(-63,14,z),brick,Enum.Material.Brick) end
 for _,s in {-1,1} do
  for _,d in {{-133,22},{-81,34}} do box("WarehousePortal",Vector3.new(d[2],28,3),Vector3.new(d[1],14,s*84),brick,Enum.Material.Brick) end
  box("PortalHeader",Vector3.new(26,10,3),Vector3.new(-110,23,s*84),brick,Enum.Material.Brick)
 end
 box("WarehouseFireWallA",Vector3.new(46,26,4),Vector3.new(-120,13,-22),brick,Enum.Material.Brick)
 box("WarehouseFireWallB",Vector3.new(46,26,4),Vector3.new(-86,13,22),brick,Enum.Material.Brick)
 -- East factory: machinery, ground flank and a protected dogleg catwalk.
 box("FactoryOuterWall",Vector3.new(3,30,168),Vector3.new(145,15,0),steel,Enum.Material.Metal)
 for _,z in {-66,0,66} do box("FactoryInnerWall",Vector3.new(3,30,36),Vector3.new(63,15,z),steel,Enum.Material.Metal) end
 for _,s in {-1,1} do
  for _,d in {{77,26},{136,18}} do box("FactoryPortal",Vector3.new(d[2],30,3),Vector3.new(d[1],15,s*84),steel,Enum.Material.Metal) end
  box("FactoryPortalHeader",Vector3.new(36,15,3),Vector3.new(108,22.5,s*84),steel,Enum.Material.Metal)
  box("CatwalkDeck",Vector3.new(14,1,48),Vector3.new(136,10.5,s*40),dark,Enum.Material.DiamondPlate)
  box("CatwalkTurn",Vector3.new(38,1,14),Vector3.new(124,10.5,s*16),dark,Enum.Material.DiamondPlate)
  for n=1,20 do box("FactoryStairs",Vector3.new(14,n*.55,1.6),Vector3.new(136,n*.275,s*(94-n*1.5)),steel,Enum.Material.Metal) end
 end
 box("CatwalkBypass",Vector3.new(14,1,32),Vector3.new(112,10.5,0),dark,Enum.Material.DiamondPlate)
 box("FactoryLiftHouse",Vector3.new(22,32,16),Vector3.new(136,16,0),steel,Enum.Material.Metal)
 box("MachineIsland",Vector3.new(18,12,48),Vector3.new(81,6,0),dark,Enum.Material.Metal)
 for _,s in {-1,1} do box("Switchgear",Vector3.new(16,14,12),Vector3.new(114,7,s*30),steel,Enum.Material.Metal) end
 -- Marked cargo bays; no random container grid or uninterrupted central lane.
 for _,s in {-1,1} do
  local cargo=box("LoadingBayCargo",Vector3.new(16,11,28),Vector3.new(-44,5.5,s*56),Color3.fromRGB(145,91,48),Enum.Material.Metal) cargo:SetAttribute("ArtContainer",true)
  box("LoadingBayBarrier",Vector3.new(5,4,26),Vector3.new(49,2,s*60),steel)
 end
 box("ControlPoint",Vector3.new(34,.12,34),Vector3.new(0,.1,0),Color3.fromRGB(48,126,147),Enum.Material.Metal)
 for _,x in {-36,36} do box("WeighbridgeControlBooth",Vector3.new(18,18,18),Vector3.new(x,9,0),steel,Enum.Material.Metal) end
 for _,x in {-25,25} do for _,s in {-1,1} do box("ObjectiveParapet",Vector3.new(10,3.5,3),Vector3.new(x,1.75,s*15),steel) end end
 Lighting.ClockTime=20.5 Lighting.Brightness=3 Lighting.ExposureCompensation=.5 Lighting.GlobalShadows=true Lighting.Ambient=Color3.fromRGB(110,122,142) Lighting.OutdoorAmbient=Color3.fromRGB(116,132,157)
 local at=Lighting:FindFirstChild("ZeroAtmosphere") or Instance.new("Atmosphere") at.Name="ZeroAtmosphere" at.Density=.22 at.Haze=1 at.Color=Color3.fromRGB(185,196,208) at.Parent=Lighting
 at.Decay=Color3.fromRGB(83,103,130) at.Glare=.1 at.Offset=0
 local cc=Lighting:FindFirstChild("ZeroColor") or Instance.new("ColorCorrectionEffect") cc.Name="ZeroColor" cc.Contrast=.05 cc.Saturation=-.06 cc.Brightness=0 cc.TintColor=Color3.new(1,1,1) cc.Parent=Lighting
 require(script.Parent.HarborDetail).build(arena)
 return arena,doors
end
return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="115">
        <Properties>
          <string name="Name">Bots</string>
          <string name="Source"><![CDATA[local PathfindingService=game:GetService("PathfindingService")
local C=require(game.ReplicatedStorage.ZeroShared.Config)
local Layout=require(game.ReplicatedStorage.ZeroShared.MapLayout)
local Characters=require(script.Parent.Characters)
local Combat=require(script.Parent.Combat)
local Bots={active={},generation=0}
local rng=Random.new()
function Bots.reset()
 Bots.generation+=1
 for m in Bots.active do m:Destroy() end
 table.clear(Bots.active)
end
function Bots.spawn(index,faction)
 faction=faction or "Bravo"
 local m=Characters.create("VEX_BOT_"..index.."_"..faction,faction,Characters.spawnPosition(faction))
 m:SetAttribute("Bot",true) m.Parent=workspace
 if faction=="Alpha" then m:PivotTo(CFrame.new(m:GetPivot().Position)*CFrame.Angles(0,math.pi,0)) end
 m.HumanoidRootPart:SetNetworkOwner(nil)
 local b={model=m,index=index,faction=faction,stage=1,route=Layout.route(faction,if index%2==1 then 1 else 2),nextPath=0,waypoints={},waypoint=1,computing=false,spottedAt=0,shots=0}
 Bots.active[m]=b
 local generation=Bots.generation
 Characters.register(m,function()
  Bots.active[m]=nil
  task.delay(C.RespawnTime,function() if generation==Bots.generation and workspace:GetAttribute("ZeroPhase")=="ACTIVE" then Bots.spawn(index,faction) end end)
 end)
 Combat.register(m)
 return m,b
end
function Bots.visible(m,target)
 local params=RaycastParams.new() params.FilterDescendantsInstances={m}
 local hit=workspace:Raycast(m.Head.Position,target.Head.Position-m.Head.Position,params)
 return hit~=nil and hit.Instance:IsDescendantOf(target)
end
local function navigate(b,goal,time)
 local m=b.model
 if not b.goal or (b.goal-goal).Magnitude>8 then b.nextPath=0 b.waypoints={} end
 b.goal=goal
 if time>=b.nextPath and not b.computing then
  b.nextPath=time+1.2 b.computing=true
  task.spawn(function()
   local path=PathfindingService:CreatePath({AgentRadius=2.5,AgentHeight=6,AgentCanJump=true,WaypointSpacing=5})
   local ok=pcall(function() path:ComputeAsync(m.HumanoidRootPart.Position,goal) end)
   if m.Parent and ok and path.Status==Enum.PathStatus.Success and b.goal and (b.goal-goal).Magnitude<8 then
    b.waypoints=path:GetWaypoints() b.waypoint=2 m:SetAttribute("BotPathStatus","Success")
   elseif m.Parent then m:SetAttribute("BotPathStatus","NoPath") end
   b.computing=false
  end)
 end
 local p=b.waypoints[b.waypoint]
 if p and (m.HumanoidRootPart.Position-p.Position).Magnitude<4.5 then b.waypoint+=1 p=b.waypoints[b.waypoint] end
 if p then
  if p.Action==Enum.PathWaypointAction.Jump then m.Humanoid.Jump=true end
  m.Humanoid:MoveTo(p.Position)
 else m.Humanoid:MoveTo(m.HumanoidRootPart.Position) end
end
-- The same brain entry point is exercised with real R15 targets by Studio tests.
function Bots.step(b,time,candidates)
 local m=b.model
 if not m.Parent or m.Humanoid.Health<=0 then return end
 local node=b.route[b.stage]
 if node and (m.HumanoidRootPart.Position-node).Magnitude<6 then b.stage+=1 node=b.route[b.stage] end
 m:SetAttribute("BotStage",b.stage)
 if node and b.stage<=7 then navigate(b,node,time) return end
 local target,distance=nil,230
 if Layout.inCombatArea(m.HumanoidRootPart.Position) then
  for _,char in candidates do
   if char~=m and char.Parent and char:FindFirstChild("Head") and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health>0 and char:GetAttribute("Faction")~=b.faction and Layout.inCombatArea(char.HumanoidRootPart.Position) then
    local d=(char.HumanoidRootPart.Position-m.HumanoidRootPart.Position).Magnitude
    if d<distance then target,distance=char,d end
   end
  end
 end
 local los=target and Bots.visible(m,target)
 if target~=b.target or not los then b.spottedAt=time end
 b.target=target m:SetAttribute("BotTarget",if target then target.Name else "")
 if los then
  local root=m.HumanoidRootPart local goal=target.HumanoidRootPart.Position
  root.CFrame=CFrame.lookAt(root.Position,Vector3.new(goal.X,root.Position.Y,goal.Z))
  if distance>60 then navigate(b,goal,time) else m.Humanoid:MoveTo(root.Position) end
  if time-b.spottedAt>=C.BotReactionTime then
   local jitter=Vector3.new(rng:NextNumber(-1,1),rng:NextNumber(-1,1),rng:NextNumber(-1,1))*C.BotSpread*distance
   if Combat.fire(m,(target.UpperTorso.Position+jitter-m.Head.Position).Unit) then b.shots+=1 m:SetAttribute("BotShots",b.shots) end
  end
 else navigate(b,Vector3.new(0,3,0),time) end
 local state=Combat.states[m] if state and state.ammo==0 then Combat.reload(m) end
end
function Bots.think()
 if workspace:GetAttribute("ZeroPhase")~="ACTIVE" then return end
 local targets={} for m in Characters.records do if m.Parent then table.insert(targets,m) end end
 for _,b in Bots.active do Bots.step(b,workspace:GetServerTimeNow(),targets) end
end
return Bots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="116">
        <Properties>
          <string name="Name">Characters</string>
          <string name="Source"><![CDATA[local C = require(game.ReplicatedStorage.ZeroShared.Config)
local Factory = require(game.ReplicatedStorage.ZeroShared.RigFactory)
local Layout = require(game.ReplicatedStorage.ZeroShared.MapLayout)
local Characters = {records = {}}
function Characters.create(name, faction, position, heroId)
 local m = Factory.create(name, faction, position, heroId)
 local health = Instance.new("Script") health.Name = "Health" health.Parent = m
 return m
end
function Characters.spawnPosition(faction)
	return Layout.spawnPosition(faction)
end
function Characters.register(m, onDeath)
	local h = m:FindFirstChildOfClass("Humanoid")
	local r = {model = m, humanoid = h, lastDamage = -math.huge, lastHealth = h.Health, spawnUntil = workspace:GetServerTimeNow() + 2}
	Characters.records[m] = r
	m:SetAttribute("ProtectedUntil", r.spawnUntil)
	h.HealthChanged:Connect(function(value)
		if value < r.lastHealth then r.lastDamage = workspace:GetServerTimeNow() end
		r.lastHealth = value
	end)
	h.Died:Once(function()
		m:SetAttribute("RespawnAt", workspace:GetServerTimeNow() + C.RespawnTime)
		if onDeath then onDeath(m) end
		task.delay(C.RespawnTime, function() Characters.records[m] = nil m:Destroy() end)
	end)
	return r
end
function Characters.regenerate(dt)
	local now = workspace:GetServerTimeNow()
	for m, r in Characters.records do
		if not m.Parent then Characters.records[m] = nil
		elseif r.humanoid.Health > 0 and now - r.lastDamage >= C.RegenDelay then
			r.humanoid.Health = math.min(r.humanoid.MaxHealth, r.humanoid.Health + C.RegenRate * dt)
		end
	end
end
return Characters
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="117">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[-- All authoritative ammo, raycasts, damage and ability timing live here.
local Players = game:GetService("Players")
local C = require(game.ReplicatedStorage.ZeroShared.Config)
local Rules = require(game.ReplicatedStorage.ZeroShared.WeaponRules)
local Layout = require(game.ReplicatedStorage.ZeroShared.MapLayout)
local Combat = {states = {}, buckets = {}}
local function now() return workspace:GetServerTimeNow() end
local function alive(m)
	local h = m and m:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0 and m:FindFirstChild("Head") and m:FindFirstChild("HumanoidRootPart")
end
local function safe(m) return Layout.isSafe(m.HumanoidRootPart.Position) end
function Combat.init(remotes)
	Combat.remotes = remotes
end
function Combat.register(m)
	local state = {ammo = C.Weapon.Magazine, lastShot = -math.huge, reloadEnd = 0, dashEnd = 0, nextDash = 0}
	Combat.states[m] = state
	Combat.sync(m)
	m.Destroying:Once(function() Combat.states[m] = nil end)
	return state
end
function Combat.sync(m)
	local s = Combat.states[m]
	if not s then return end
	m:SetAttribute("Ammo", s.ammo)
	m:SetAttribute("ReloadEnd", s.reloadEnd)
	m:SetAttribute("DashReadyAt", s.nextDash)
end
function Combat.allowed(m)
	local player = m and Players:GetPlayerFromCharacter(m)
	if player and player:GetAttribute("ZeroSession") ~= "ACTIVE" then return false end
	return alive(m) and Combat.states[m] ~= nil and workspace:GetAttribute("ZeroPhase") == "ACTIVE"
end
function Combat.reload(m)
	local s = Combat.states[m]
	if not Combat.allowed(m) or s.reloadEnd ~= 0 or s.ammo == C.Weapon.Magazine then return false end
	s.reloadEnd = now() + C.Weapon.ReloadTime
	Combat.sync(m)
	task.delay(C.Weapon.ReloadTime, function()
		if Combat.states[m] == s and alive(m) then
			s.ammo, s.reloadEnd = C.Weapon.Magazine, 0
			Combat.sync(m)
		end
	end)
	return true
end
function Combat.damage(shooter, target, amount)
	if not alive(target) or not Rules.enemy(shooter, target) or safe(target) then return false end
	if now() < (target:GetAttribute("ProtectedUntil") or 0) then return false end
	local h = target:FindFirstChildOfClass("Humanoid")
	local shooterPlayer = Players:GetPlayerFromCharacter(shooter)
	if h.Health <= amount and shooterPlayer then
		local kills = shooterPlayer:FindFirstChild("leaderstats") and shooterPlayer.leaderstats:FindFirstChild("Kills")
		if kills then kills.Value += 1 end
	end
	h:TakeDamage(amount)
	return true
end
function Combat.fire(m, direction)
	if not Combat.allowed(m) or not Rules.direction(direction) or safe(m) then return false end
	local s, time = Combat.states[m], now()
	if not Rules.canFire(s, time, C.Weapon.FireInterval) then return false end
	s.ammo -= 1
	s.lastShot = time
	Combat.sync(m)
	local origin = m.Head.Position
	local params = RaycastParams.new()
	params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, {m}
	local result = workspace:Raycast(origin, direction.Unit * C.Weapon.Range, params)
	local endpoint = if result then result.Position else origin + direction.Unit * C.Weapon.Range
	local hit, headshot, killed = false, false, false
	if result then
		local target = result.Instance:FindFirstAncestorOfClass("Model")
		if target and target:FindFirstChildOfClass("Humanoid") then
			headshot = result.Instance.Name == "Head"
			hit = Combat.damage(m, target, C.Weapon.Damage * (if headshot then C.Weapon.HeadMultiplier else 1))
			killed = hit and target.Humanoid.Health <= 0
		end
	end
	Combat.remotes.FX:FireAllClients(m, origin, endpoint, hit, headshot, killed)
	return true, result
end
function Combat.dash(m, direction)
	if not Combat.allowed(m) or not Rules.direction(direction) then return false end
	local s, time = Combat.states[m], now()
	if time < s.nextDash then return false end
	local horizontal = Vector3.new(direction.X, 0, direction.Z)
	if horizontal.Magnitude < .1 then return false end
	horizontal = horizontal.Unit
	s.nextDash, s.dashEnd = time + C.Dash.Cooldown, time + C.Dash.Duration
	Combat.sync(m)
	local root = m.HumanoidRootPart
	-- A block sweep prevents dashing through thin walls, including spawn doors.
	local params = RaycastParams.new() params.FilterDescendantsInstances = {m}
	local distance = C.Dash.Speed * C.Dash.Duration
	local block = workspace:Blockcast(root.CFrame, Vector3.new(2, 4, 2), horizontal * distance, params)
	local speed = if block then math.max(0, block.Distance - 1) / C.Dash.Duration else C.Dash.Speed
	local canOwn = root:CanSetNetworkOwnership()
	if canOwn then root:SetNetworkOwner(nil) end
	local attachment = Instance.new("Attachment") attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0, velocity.RelativeTo = attachment, Enum.ActuatorRelativeTo.World
	velocity.MaxForce = 100000
	velocity.VectorVelocity = horizontal * speed + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
	velocity.Parent = root
	task.delay(C.Dash.Duration, function()
		velocity:Destroy() attachment:Destroy()
		if root.Parent then
			root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			if canOwn and Players:GetPlayerFromCharacter(m) then root:SetNetworkOwnershipAuto() end
		end
	end)
	return true
end
function Combat.request(player, action, direction)
	-- Token bucket covers malformed actions as well as valid requests.
	local t = now()
	local b = Combat.buckets[player] or {tokens = 24, time = t}
	b.tokens = math.min(24, b.tokens + (t - b.time) * 16)
	b.time = t
	Combat.buckets[player] = b
	if b.tokens < 1 then return end
	b.tokens -= 1
	local m = player.Character
	if not m or not m.Parent then return end
	if action == "Fire" then Combat.fire(m, direction)
	elseif action == "Reload" then Combat.reload(m)
	elseif action == "Dash" then Combat.dash(m, direction) end
end
return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="118">
        <Properties>
          <string name="Name">HarborDetail</string>
          <string name="Source"><![CDATA[local G=require(game.ReplicatedStorage.ZeroShared.Geometry)
local Detail={}
function Detail.build(arena)
 local f=Instance.new("Folder") f.Name="HarborDetail" f.Parent=arena
 local steel,dark,pale,orange=Color3.fromRGB(89,107,119),Color3.fromRGB(31,42,53),Color3.fromRGB(197,212,219),Color3.fromRGB(184,109,51)
 local count=0
 local function box(name,size,pos,color,mat,rotation)
  local p=G.part(f,name,size,CFrame.new(pos)*(rotation or CFrame.identity),color or steel,mat or Enum.Material.Metal)
  p.CanCollide=false p.CanQuery=false p.CanTouch=false p.CastShadow=size.Magnitude>18 count+=1
  if count%120==0 then task.wait() end
  return p
 end
 local function sign(text,pos,size,face,color)
  local p=box("Wayfinding",size,pos,dark)
  local gui=Instance.new("SurfaceGui") gui.Face=face or Enum.NormalId.Front gui.PixelsPerStud=24 gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud gui.LightInfluence=.2 gui.Parent=p
  local l=Instance.new("TextLabel") l.Size=UDim2.fromScale(.94,.88) l.Position=UDim2.fromScale(.03,.06) l.BackgroundTransparency=1 l.Text=text l.TextScaled=true l.Font=Enum.Font.GothamBold l.TextColor3=color or pale l.Parent=gui
 end
 local function light(pos,color,range)
  local p=box("Luminaire",Vector3.new(4,.4,1),pos,color,Enum.Material.Neon)
  local l=Instance.new("PointLight") l.Color=color l.Range=range or 35 l.Brightness=1.8 l.Shadows=false l.Parent=p
 end
 -- Architectural detail belongs to specific structures and never changes collision.
 for _,p in arena:GetChildren() do
  if p:IsA("BasePart") and (p.Name=="CrossDock" or p.Name=="WorkshopGatehouse" or p.Name=="TransferOffice" or p.Name=="DispatchHouse" or p.Name=="ServiceWarehouse") then
   local z=p.Position.Z local front=z-math.sign(z)*(p.Size.Z/2+.2)
   box("RoofCoping",p.Size*Vector3.new(1,0,1)+Vector3.new(2,1,2),p.Position+Vector3.new(0,p.Size.Y/2+.5,0),dark)
   local columns=math.max(1,math.floor(p.Size.X/14))
   for n=1,columns do
    local x=p.Position.X-p.Size.X/2+(n-.5)*p.Size.X/columns
    local panel=box("Clerestory",Vector3.new(math.min(8,p.Size.X/columns-2),3,.2),Vector3.new(x,p.Size.Y-6,front),if z<0 then Color3.fromRGB(154,171,176) else Color3.fromRGB(204,170,125),Enum.Material.Glass) panel.Transparency=.25
   end
   box("ServiceDoor",Vector3.new(math.min(9,p.Size.X-2),12,.3),Vector3.new(p.Position.X,6,front),dark)
   for y=2,12,2 do box("ShutterSlat",Vector3.new(math.min(9,p.Size.X-2),.1,.2),Vector3.new(p.Position.X,y,front-.15),steel) end
   light(Vector3.new(p.Position.X,16,front-math.sign(z)),Color3.fromRGB(235,207,168),34)
  end
 end
 for _,s in {-1,1} do
  local accent=if s<0 then Color3.fromRGB(65,157,190) else Color3.fromRGB(195,100,49)
  local face=if s<0 then Enum.NormalId.Front else Enum.NormalId.Back
  local inward=if s<0 then Enum.NormalId.Back else Enum.NormalId.Front
  -- Two wayfinding systems describe distinct operations rather than mirrored labels.
  sign(if s<0 then "VANGUARD // KAJKONTOR" else "ZERO // TULLTERMINAL",Vector3.new(0,20,s*214),Vector3.new(58,4,.2),face,accent)
  for _,x in {-42,42} do
   sign(if x<0 then "01 MAGASIN / VÄSTRA VÄGEN" else "03 VERKSTAD / ÖSTRA VÄGEN",Vector3.new(x,16,s*213.6),Vector3.new(24,2,.2),face,pale)
   light(Vector3.new(x,24,s*231),accent,32)
   sign("KAJVÄG / FÖLJ GUL LINJE",Vector3.new(x,10,s*185.2),Vector3.new(26,3,.2),face,pale)
  end
  for _,x in {-96,96} do
   light(Vector3.new(x,23,s*194),Color3.fromRGB(221,208,183),40)
   sign("←  LASTGÅRD  /  FÖLJ GUL LINJE",Vector3.new(x,9,s*137.3),Vector3.new(29,3,.2),face)
   -- Painted L-shaped circulation lines follow the actual two-turn routes.
   for _,a in {{69,198,54, .35},{96,173,.35,50},{72,148,48,.35},{48,122,.35,52}} do
    box("ExitRoutePaint",Vector3.new(a[3],.025,a[4]),Vector3.new(math.sign(x)*a[1],.025,s*a[2]),orange)
   end
  end
  for _,x in {-52,-44,44,52} do
   box("Locker",Vector3.new(5,11,3),Vector3.new(x,6,s*247),dark)
   box("LockerHandle",Vector3.new(.15,1,.1),Vector3.new(x,6,s*245.4),pale)
  end
  for _,x in {-26,26} do box("RoomBench",Vector3.new(14,2,3),Vector3.new(x,1.5,s*240),steel) end
  sign("HAMNVERKET 2042\n01 MAGASIN | 02 LASTGÅRD | 03 FABRIK",Vector3.new(0,12,s*250.8),Vector3.new(32,9,.2),inward)
  sign("02 LASTGÅRD\nCENTRAL KONTROLLPUNKT",Vector3.new(0,18,s*30.7),Vector3.new(30,5,.2),inward)
  -- Functional bays on the dispatch buildings give them a recognizable purpose.
  for _,x in {-19,19} do box("OfficeDownpipe",Vector3.new(.5,24,.5),Vector3.new(x,12,s*42),steel) end
 end
 -- The west brick warehouse has repeated structural bays and roof sawteeth.
 for z=-72,72,24 do
  box("WarehouseButtress",Vector3.new(2,28,2),Vector3.new(-61.2,14,z),steel)
  box("WarehouseRoofVent",Vector3.new(30,2,8),Vector3.new(-104,31,z),steel)
  -- Repeated sawtooth roof bays give the brick warehouse a coherent industrial profile.
  local roof=box("SawtoothRoof",Vector3.new(78,.6,15),Vector3.new(-103,33.2,z),dark,Enum.Material.Metal,CFrame.Angles(-.2,0,0))
  roof.CastShadow=true
  local glazing=box("NorthlightGlazing",Vector3.new(74,3,.2),Vector3.new(-103,32.8,z+7.4),Color3.fromRGB(132,160,172),Enum.Material.Glass)
  glazing.Transparency=.3
  for _,x in {-131,-103,-75} do box("RoofGlazingMullion",Vector3.new(.2,3,.3),Vector3.new(x,32.8,z+7.2),steel) end
  light(Vector3.new(-103,26,z),Color3.fromRGB(226,201,157),30)
 end
 for z=-60,60,24 do
  box("FactoryColumn",Vector3.new(2,28,2),Vector3.new(64.8,14,z),steel)
  box("FactoryTruss",Vector3.new(78,1.2,1.2),Vector3.new(104,30,z),steel)
 end
 for _,s in {-1,1} do
  for z=20,60,10 do
   for _,x in {129,143} do box("CatwalkRailPost",Vector3.new(.2,3,.2),Vector3.new(x,12.5,s*z),orange) end
  end
  for _,x in {129,143} do box("CatwalkHandrail",Vector3.new(.2,.2,44),Vector3.new(x,14,s*42),orange) end
  light(Vector3.new(110,25,s*58),Color3.fromRGB(187,210,221),40)
 end
 for _,p in arena:GetChildren() do if p:GetAttribute("ArtContainer") then
  for dx=-7,7,2 do box("ContainerRib",Vector3.new(.18,10,28.2),p.Position+Vector3.new(dx,0,0),dark) end
  for _,dx in {-4,4} do box("CargoDoor",Vector3.new(7.6,10,.2),p.Position+Vector3.new(dx,0,-14.2),p.Color) end
  sign("NHU 2042 // KAJ 02",p.Position+Vector3.new(0,3,-14.4),Vector3.new(13,1.5,.2))
 end end
 for _,x in {-54,54} do
  box("Drain",Vector3.new(1,.03,180),Vector3.new(x,.02,0),dark,Enum.Material.DiamondPlate)
  for _,z in {-90,90} do light(Vector3.new(x,19,z),Color3.fromRGB(206,218,221),38) end
 end
 -- Puddles are restrained and placed in loading/drainage areas, away from stair treads.
 for _,p in {{-40,-92,12,5},{38,88,9,4},{-35,15,7,5},{42,-18,8,3},{96,152,13,4},{-96,-152,11,3}} do
  local puddle=box("RainPuddle",Vector3.new(p[3],.02,p[4]),Vector3.new(p[1],.035,p[2]),Color3.fromRGB(66,92,108),Enum.Material.Glass) puddle.Transparency=.35 puddle.Reflectance=.3
 end
 local art=game.ServerStorage:FindFirstChild("ZeroArt")
 if art and art:FindFirstChild("IndustrialPipes") then
  for _,p in {{-151,7,-165},{151,7,165},{70,7,-58},{70,7,58}} do local kit=art.IndustrialPipes:Clone() kit.Name="ReviewedServicePipes" kit:ScaleTo(1.5) kit:PivotTo(CFrame.new(unpack(p))*CFrame.Angles(0,0,math.pi/2)) kit.Parent=f end
 end
 -- Harbor scenery has no combat collision; the quay remains visually open to water.
 for _,z in {-98,105} do
  for _,x in {-205,-178} do box("GantryLeg",Vector3.new(3,64,3),Vector3.new(x,28,z),orange) end
  box("GantryBeam",Vector3.new(87,4,5),Vector3.new(-200,61,z),orange)
  box("CraneCabin",Vector3.new(7,7,7),Vector3.new(-180,55,z),steel)
  for y=5,45,20 do
   box("GantryBrace",Vector3.new(36,.7,.7),Vector3.new(-191,y+7,z),orange,Enum.Material.Metal,CFrame.Angles(0,0,.45))
  end
  box("CraneCable",Vector3.new(.2,35,.2),Vector3.new(-232,42,z),dark)
  box("CraneSpreader",Vector3.new(18,2,4),Vector3.new(-232,24,z),orange)
 end
 box("ShipHull",Vector3.new(38,16,140),Vector3.new(-243,-1,5),dark)
 box("ShipBridge",Vector3.new(28,24,26),Vector3.new(-243,17,47),steel)
 if art and art:FindFirstChild("ShippingContainer") then for n=1,6 do local c=art.ShippingContainer:Clone() c.Name="ShipCargo" c:ScaleTo(.6) c:PivotTo(CFrame.new(-243,10,10-n*16)) c.Parent=f end end
 for n=1,9 do
  local h=24+(n%4)*7 box("NorrhamnSkyline",Vector3.new(24,h,28),Vector3.new(-170+n*40,h/2-4,-320),dark,Enum.Material.Brick)
 end
 for _,x in {-22,22} do box("ControlEdge",Vector3.new(.3,.04,42),Vector3.new(x,.03,0),Color3.fromRGB(55,154,174),Enum.Material.Neon) end
 return f
end
return Detail
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="119">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source">local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Teams=game:GetService("Teams")
local C=require(ReplicatedStorage.ZeroShared.Config)
local Characters=require(script.Parent.Characters)
local Combat=require(script.Parent.Combat)
local Bots=require(script.Parent.Bots)
local Match=require(script.Parent.MatchService)
Players.CharacterAutoLoads=false Players.RespawnTime=C.RespawnTime
local folder=Instance.new("Folder") folder.Name="ZeroRemotes" folder.Parent=ReplicatedStorage
local remotes={}
for _,name in {"Action","FX","Flow"} do local e=Instance.new("RemoteEvent") e.Name=name e.Parent=folder remotes[name]=e end
Combat.init(remotes) remotes.Action.OnServerEvent:Connect(Combat.request) remotes.Flow.OnServerEvent:Connect(Match.request)
local arena,doors=require(script.Parent.Arena).build() Match.doors=doors Match.reset()
for _,name in {"Baseplate","SpawnLocation"} do local p=workspace:FindFirstChild(name) if p and p:IsA("BasePart") then p.Transparency=1 p.CanCollide=false p.CanQuery=false end end
for _,name in {"Alpha","Bravo"} do local team=Teams:FindFirstChild(name) or Instance.new("Team") team.Name=name team.AutoAssignable=false team.TeamColor=BrickColor.new(if name=="Alpha" then "Cyan" else "Bright orange") team.Parent=Teams end
local joined=0
local function add(p)
 joined+=1 p.Team=Teams:FindFirstChild(if workspace:GetAttribute("ZeroPvP") and joined%2==0 then "Bravo" else "Alpha")
 local stats=Instance.new("Folder") stats.Name="leaderstats" stats.Parent=p
 for _,name in {"Kills","Deaths"} do local v=Instance.new("IntValue") v.Name=name v.Parent=stats end
 Match.addPlayer(p)
end
Players.PlayerAdded:Connect(add)
for _,p in Players:GetPlayers() do add(p) end
Players.PlayerRemoving:Connect(function(p) Combat.buckets[p]=nil Match.buckets[p]=nil Match.selectSerial[p]=nil if p.Character then p.Character:Destroy() end task.defer(function() if Match.participants()==0 then Match.reset() end end) end)
local elapsed,regen=0,0
RunService.Heartbeat:Connect(function(dt)
 elapsed+=dt regen+=dt
 if elapsed&gt;=C.BotThinkInterval then elapsed=0 Bots.think() end
 if regen&gt;=.2 then Characters.regenerate(regen) regen=0 end
end)</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="120">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local C=require(game.ReplicatedStorage.ZeroShared.Config)
local Characters=require(script.Parent.Characters)
local Combat=require(script.Parent.Combat)
local Bots=require(script.Parent.Bots)
local Match={doors={},round=0,buckets={},selectSerial={}}
local function now() return workspace:GetServerTimeNow() end
local function phase(p,value) p:SetAttribute("ZeroSession",value) end
local function removeCharacter(p)
 local m=p.Character p.Character=nil if m then m:Destroy() end
end
local function freeze(p,value)
 local m=p.Character if not m then return end
 m.HumanoidRootPart.Anchored=value m.Humanoid.WalkSpeed=if value then 0 else C.WalkSpeed
 m.Humanoid.JumpPower=if value then 0 else 42
 if not value then m.HumanoidRootPart:SetNetworkOwner(p) end
end
function Match.setDoors(open)
 for _,d in Match.doors do
  local closed=d:GetAttribute("ClosedCFrame") d.CanCollide=not open d.CanQuery=not open
  TweenService:Create(d,TweenInfo.new(.6),{CFrame=if open then closed+Vector3.new(0,16,0) else closed}):Play()
 end
end
function Match.participants()
 local n=0 for _,p in Players:GetPlayers() do local s=p:GetAttribute("ZeroSession") if s=="ACTIVE" or s=="INSPECT" or s=="PREPARE" then n+=1 end end return n
end
function Match.reset()
 Match.round+=1 Bots.reset() workspace:SetAttribute("ZeroPhase","IDLE") workspace:SetAttribute("ZeroRoundEnd",0) Match.setDoors(false)
end
function Match.finishRound()
 Match.round+=1 Bots.reset() workspace:SetAttribute("ZeroPhase","RESULTS")
 for _,p in Players:GetPlayers() do
  local s=p:GetAttribute("ZeroSession")
  if s=="ACTIVE" or s=="INSPECT" or s=="PREPARE" then
   p:SetAttribute("ZeroResultKills",p.leaderstats.Kills.Value) p:SetAttribute("ZeroResultDeaths",p.leaderstats.Deaths.Value)
   phase(p,"RESULTS") removeCharacter(p)
  end
 end
 Match.setDoors(false)
end
function Match.startRound()
 Match.round+=1 local token=Match.round
 workspace:SetAttribute("ZeroPhase","PREPARE") workspace:SetAttribute("ZeroPhaseEnd",now()+C.PreparationTime)
 Match.setDoors(false)
 task.delay(C.PreparationTime,function()
  if Match.round~=token or Match.participants()==0 then return end
  workspace:SetAttribute("ZeroPhase","ACTIVE") workspace:SetAttribute("ZeroRoundEnd",now()+180) Match.setDoors(true)
  for _,p in Players:GetPlayers() do if p:GetAttribute("ZeroSession")=="PREPARE" then phase(p,"ACTIVE") freeze(p,false) end end
  for i=1,C.BotCount do Bots.spawn(i) end
  task.delay(180,function() if Match.round==token then Match.finishRound() end end)
 end)
end
function Match.spawn(p)
 if p.Parent~=Players then return end
 local session=p:GetAttribute("ZeroSession")
 if session~="ACTIVE" and session~="PREPARE" and session~="INSPECT" then return end
 removeCharacter(p)
 local faction=p.Team.Name
 local m=Characters.create(p.Name,faction,Characters.spawnPosition(faction)) m.Parent=workspace
 if faction=="Alpha" then m:PivotTo(CFrame.new(m:GetPivot().Position)*CFrame.Angles(0,math.pi,0)) end
 Characters.register(m,function()
  p.leaderstats.Deaths.Value+=1
  task.delay(C.RespawnTime,function() if p.Parent==Players and (p:GetAttribute("ZeroSession")=="ACTIVE" or p:GetAttribute("ZeroSession")=="INSPECT") then phase(p,"ACTIVE") Match.spawn(p) end end)
 end)
 Combat.register(m) p.Character=m p.CameraMode=Enum.CameraMode.LockFirstPerson
 freeze(p,session=="PREPARE" or session=="INSPECT")
end
function Match.deploy(p,hero)
 if p:GetAttribute("ZeroSession")~="SELECT" or hero~="VEX" then return false end
 p.leaderstats.Kills.Value=0 p.leaderstats.Deaths.Value=0
 local roundPhase=workspace:GetAttribute("ZeroPhase")
 if roundPhase~="ACTIVE" and roundPhase~="PREPARE" then Match.startRound() roundPhase="PREPARE" end
 phase(p,roundPhase) Match.spawn(p) return true
end
function Match.request(p,action,arg)
 local t=now() local b=Match.buckets[p] or {tokens=8,time=t}
 b.tokens=math.min(8,b.tokens+(t-b.time)*4) b.time=t Match.buckets[p]=b
 if b.tokens<1 then return end b.tokens-=1
 local s=p:GetAttribute("ZeroSession")
 if action=="Play" and (s=="MENU" or s=="RESULTS") then
  phase(p,"SELECT") Match.selectSerial[p]=(Match.selectSerial[p] or 0)+1 local serial=Match.selectSerial[p]
  p:SetAttribute("ZeroSelectEnd",t+30)
  task.delay(30,function() if p.Parent==Players and Match.selectSerial[p]==serial and p:GetAttribute("ZeroSession")=="SELECT" then Match.deploy(p,"VEX") end end)
 elseif action=="Deploy" then Match.deploy(p,arg)
 elseif action=="Menu" then
  phase(p,"MENU") removeCharacter(p)
  if Match.participants()==0 then Match.reset() end
 elseif action=="Inspect" and s=="ACTIVE" then phase(p,"INSPECT") freeze(p,true)
 elseif action=="Resume" and s=="INSPECT" then phase(p,"ACTIVE") freeze(p,false) end
end
function Match.addPlayer(p)
 phase(p,"MENU")
 removeCharacter(p)
end
return Match
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="121">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="122">
      <Properties>
        <string name="Name">ZeroArt</string>
      </Properties>
      <Item class="Model" referent="123">
        <Properties>
          <string name="Name">IndustrialPipes</string>
