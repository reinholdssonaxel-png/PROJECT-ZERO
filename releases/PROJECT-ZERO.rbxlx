            <bool name="CastShadow">false</bool>
            <token name="CollisionFidelity">2</token>
            <Color3uint8 name="Color3uint8">10724005</Color3uint8>
            <token name="Material">256</token>
            <Content name="MeshContent">
              <uri>rbxassetid://12308850014</uri>
            </Content>
