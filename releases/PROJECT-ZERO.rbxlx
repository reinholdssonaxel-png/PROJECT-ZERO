      <Item class="ModuleScript" referent="141">
        <Properties>
          <string name="Name">ArmorAnimation.spec</string>
          <string name="Source"><![CDATA[-- Engine regression: armor follows moving R15 limbs; repeated poses never drift.
local Suite={}
function Suite.run()
 local Shared=game.ReplicatedStorage.ZeroShared
 local Factory,Pose=require(Shared.RigFactory),require(Shared.AnimationPose)
 local heartbeat=game:GetService("RunService").Heartbeat
 local report={assertions=0,maxMountError=0,heroes={}}
 local function check(ok,message) assert(ok,message) report.assertions+=1 end
 for _,id in require(Shared.HeroCatalog).Order do
  local m=Factory.create("ZeroArmorMotion_"..id,"Alpha",Vector3.new(0,400,0),id)
  m.HumanoidRootPart.Anchored=true m.Parent=workspace
  local ok,err=pcall(function()
   local mounts,motors={},{}
   local parts,meshes=0,0
   for _,v in m:GetDescendants() do
    if v:IsA("BasePart") then parts+=1 if v:IsA("MeshPart") then meshes+=1 end end
    if v:IsA("WeldConstraint") and v.Name=="ArmorMount" then mounts[v]=v.Part0.CFrame:ToObjectSpace(v.Part1.CFrame) end
    if v:IsA("Motor6D") then table.insert(motors,v) end
   end
   for _,action in {"Idle","Run","Fire","Reload"} do
    for step=1,4 do
     Pose.apply(m,step*.19,if action=="Run" then 1 else 0,action,step/4)
     heartbeat:Wait() heartbeat:Wait()
     for weld,offset in mounts do
      local now=weld.Part0.CFrame:ToObjectSpace(weld.Part1.CFrame)
      local error=(offset.Position-now.Position).Magnitude
      report.maxMountError=math.max(report.maxMountError,error)
      check(error<.003 and offset.UpVector:Dot(now.UpVector)>.9999 and offset.RightVector:Dot(now.RightVector)>.9999,id.." detached armor during "..action)
     end
    end
   end
   Pose.apply(m,1,0,"Idle",.5)
   local expected={} for _,j in motors do expected[j]=j.C0 end
   for step=1,100 do
    Pose.apply(m,step*.13,1,if step%2==0 then "Reload" else "Fire",(step%10)/10)
    if step%10==0 then heartbeat:Wait() end
   end
   Pose.apply(m,1,0,"Idle",.5)
   for _,j in motors do check(j.C0:FuzzyEq(expected[j],.0001),id.." cumulative animation drift") end
   report.heroes[id]={parts=parts,meshes=meshes,motors=#motors}
  end)
  m:Destroy()
  if not ok then error(err) end
 end
 print("[PROJECT ZERO] PASS: "..report.assertions.." moving armor assertions")
 return report
end
return Suite
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="142">
        <Properties>
          <string name="Name">Combat.spec</string>
          <string name="Source"><![CDATA[-- Run only in a Studio server play session:
-- require(game.ServerStorage.ZeroTests["Combat.spec"]).run()
local Suite = {}
function Suite.run()
	local C = require(game.ReplicatedStorage.ZeroShared.Config)
	local Rules = require(game.ReplicatedStorage.ZeroShared.WeaponRules)
	local Layout = require(game.ReplicatedStorage.ZeroShared.MapLayout)
	local Characters = require(game.ServerScriptService.ZeroServer.Characters)
	local Combat = require(game.ServerScriptService.ZeroServer.Combat)
	assert(workspace:GetAttribute("ZeroPhase") == "ACTIVE", "Wait for preparation to finish")
	local checks = 0
	local function check(condition, message) assert(condition, message) checks += 1 end
	local shooter, target
	local ok, err = xpcall(function()
		check(not Rules.direction(nil), "nil direction")
		check(not Rules.direction(Vector3.zero), "zero direction")
		check(not Rules.direction(Vector3.new(0/0, 0, 0)), "NaN direction")
		check(not Rules.direction(Vector3.new(math.huge, 0, 0)), "infinite direction")
		check(not Rules.direction(Vector3.new(0, 0, -20)), "scaled direction")
		shooter = Characters.create("TestShooter", "Alpha", Vector3.new(0, 35, -50))
		target = Characters.create("TestTarget", "Bravo", Vector3.new(0, 35, -30))
		shooter.Parent, target.Parent = workspace, workspace
		shooter.HumanoidRootPart.Anchored, target.HumanoidRootPart.Anchored = true, true
		Characters.register(shooter) Characters.register(target)
		target:SetAttribute("ProtectedUntil", 0)
		local state = Combat.register(shooter)
		Combat.register(target)
		local function aim(part) return (part.Position - shooter.Head.Position).Unit end
		check(Combat.fire(shooter, aim(target.UpperTorso)), "first shot accepted")
		check(target.Humanoid.Health == 262, "body shot is 13 damage")
		check(state.ammo == 35, "authoritative ammo decremented")
		check(not Combat.fire(shooter, aim(target.Head)), "rapid request rejected")
		state.lastShot = -math.huge
		check(Combat.fire(shooter, aim(target.Head)), "headshot accepted")
		check(target.Humanoid.Health == 242.5, "headshot multiplier is 1.5")
		local health = target.Humanoid.Health
		target:SetAttribute("Faction", "Alpha")
		state.lastShot = -math.huge Combat.fire(shooter, aim(target.Head))
		check(target.Humanoid.Health == health, "friendly fire blocked")
		target:SetAttribute("Faction", "Bravo")
		local wall = Instance.new("Part")
		wall.Name, wall.Size, wall.Anchored = "TestOccluder", Vector3.new(10, 12, 1), true
		wall.CFrame = CFrame.new(0, 39, -40) wall.Parent = workspace
		state.lastShot = -math.huge Combat.fire(shooter, aim(target.Head))
		wall:Destroy()
		check(target.Humanoid.Health == health, "wall stops damage")
		local originalPivot = target:GetPivot()
		target:PivotTo(originalPivot + Vector3.new(1000, 0, 0))
		state.lastShot = -math.huge Combat.fire(shooter, aim(target.Head))
		check(target.Humanoid.Health == health, "weapon range enforced")
		target:PivotTo(originalPivot)
		local originalShooter = shooter:GetPivot()
		shooter:PivotTo(CFrame.new(Layout.spawnPosition("Alpha") + Vector3.new(0,3.1,0)))
		local beforeAmmo = state.ammo
		check(not Combat.fire(shooter, aim(target.Head)) and state.ammo == beforeAmmo, "safe room blocks firing without spending ammo")
		shooter:PivotTo(originalShooter)
		target:SetAttribute("ProtectedUntil", workspace:GetServerTimeNow() + 100)
		check(not Combat.damage(shooter, target, 13), "spawn protection")
		target:SetAttribute("ProtectedUntil", 0)
		check(Combat.reload(shooter), "reload accepted")
		check(not Combat.fire(shooter, aim(target.Head)), "shooting during reload blocked")
		check(not Combat.reload(shooter), "duplicate reload blocked")
		task.wait(C.Weapon.ReloadTime + .1)
		check(state.ammo == 36 and state.reloadEnd == 0, "reload completes")
		state.ammo = 0 state.lastShot = -math.huge
		check(not Combat.fire(shooter, aim(target.Head)), "empty magazine blocked")
		state.ammo = 36
		local record = Characters.records[target]
		record.lastDamage = workspace:GetServerTimeNow()
		Characters.regenerate(.2)
		check(target.Humanoid.Health == health, "regen delay enforced")
		record.lastDamage -= 6
		Characters.regenerate(.2)
		check(math.abs(target.Humanoid.Health - health - 3) < .01, "regen at 15 HP per second")
		shooter.HumanoidRootPart.Anchored = false
		check(Combat.dash(shooter, Vector3.new(1, 0, 0)), "dash accepted")
		check(not Combat.dash(shooter, Vector3.new(1, 0, 0)), "dash cooldown enforced")
		check(state.nextDash > workspace:GetServerTimeNow() + 7, "eight second dash cooldown")
		task.wait(C.Dash.Duration + .05)
		check(shooter.HumanoidRootPart:FindFirstChildOfClass("LinearVelocity") == nil, "dash force removed after duration")
		shooter.Humanoid.Health = 0
		check(not Combat.fire(shooter, aim(target.Head)), "dead shooter rejected")
	end, debug.traceback)
	if shooter then Characters.records[shooter] = nil shooter:Destroy() end
	if target then Characters.records[target] = nil target:Destroy() end
	if not ok then error(err) end
	print("[PROJECT ZERO] PASS: " .. checks .. " combat assertions")
	return checks
end
return Suite
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="143">
        <Properties>
          <string name="Name">Heroes.spec</string>
          <string name="Source"><![CDATA[local Suite={}
function Suite.run()
	local Catalog=require(game.ReplicatedStorage.ZeroShared.HeroCatalog)
	local Factory=require(game.ReplicatedStorage.ZeroShared.RigFactory)
	local Pose=require(game.ReplicatedStorage.ZeroShared.AnimationPose)
	local expected={TITAN=700,ATLAS=650,VEX=275,PHANTOM=250,HAVOC=300,SPECTRE=225,NOVA=250,ECHO=275}
	local checks=0
	local function check(ok,message) assert(ok,message) checks+=1 end
	check(#Catalog.Order==8,"eight canonical heroes")
	for _,id in Catalog.Order do
		local m=Factory.create(id,"Alpha",Vector3.new(0,50,0),id)
		local ok,err=pcall(function()
			check(m.Humanoid.RigType==Enum.HumanoidRigType.R15,id.." R15")
			check(m.Humanoid.MaxHealth==expected[id],id.." canonical HP")
			check(m:GetAttribute("Hero")==id,id.." identity")
			check(m:GetAttribute("WeaponName")==Catalog.Heroes[id].Weapon,id.." weapon")
			check(m:FindFirstChild("Visor")~=nil,id.." visual identity")
			check(m:GetAttribute("ArtStatus")=="MESH",id.." reviewed mesh art available")
			check(m.UpperTorso:IsA("MeshPart"),id.." native R15 human body mesh")
			local motors,parts,sources=0,0,0
			for _,v in m:GetDescendants() do
				if v:IsA("Motor6D") then motors+=1 end
				if v:IsA("BasePart") then parts+=1 end
				if v:IsA("LuaSourceContainer") then sources+=1 end
			end
			check(motors==15,id.." full articulated R15 skeleton")
			check(parts<100,id.." part budget")
			check(sources==0,id.." no embedded gameplay scripts")
			local mounts=0
			for _,v in m:GetDescendants() do if v:IsA("BasePart") and v:GetAttribute("ArmorLimb") then
				local weld=v:FindFirstChild("ArmorMount")
				check(not v.Anchored and v.Massless and not v.CanCollide and not v.CanQuery and not v.CanTouch,id.." armor cannot affect hitboxes/physics")
				check(weld and weld.Part0==m[v:GetAttribute("ArmorLimb")] and weld.Part1==v,id.." correct single-limb armor mount")
				mounts+=1
			end end
			check(mounts>=8,id.." articulated mesh armor fitted")
			for _,action in {"Idle","Run","Fire","Reload"} do Pose.apply(m,1,.5,action,.5) end
			check(m.Humanoid:FindFirstChildOfClass("Animator")~=nil,id.." future clip support")
			check(Catalog.Heroes[id].Playable==(id=="VEX"),id.." honest selection availability")
			if id=="PHANTOM" then
				local left=0
				for _,v in m:GetDescendants() do if v:IsA("WeldConstraint") and v.Part0==m.LeftHand and v.Part1:GetAttribute("GripHand")=="Left" then left+=1 end end
				check(left>=1,"PHANTOM left pistol is held in left hand")
			elseif id=="ATLAS" then
				check(m:FindFirstChild("PoweredGauntletLeft")~=nil and m:FindFirstChild("PoweredGauntletRight")~=nil,"ATLAS paired fitted gauntlets")
			end
		end)
		m:Destroy()
		if not ok then error(err) end
	end
	local arena=workspace:FindFirstChild("ZeroArena")
	if arena then
		check(#arena:GetDescendants()<1600,"arena instance budget")
		local parts,meshes=0,0
		for _,v in arena:GetDescendants() do if v:IsA("BasePart") then parts+=1 if v:IsA("MeshPart") then meshes+=1 end end end
		check(parts<1100,"arena part budget")
		check(meshes<=40,"bounded imported mesh count")
	end
	print("[PROJECT ZERO] PASS: "..checks.." hero/art assertions")
	return checks
end
return Suite
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="144">
        <Properties>
          <string name="Name">Map.spec</string>
          <string name="Source"><![CDATA[local Suite={}
function Suite.run()
	local Layout=require(game.ReplicatedStorage.ZeroShared.MapLayout)
	local Pathfinding=game:GetService("PathfindingService")
	local Characters=require(game.ServerScriptService.ZeroServer.Characters)
	local Combat=require(game.ServerScriptService.ZeroServer.Combat)
	local Bots=require(game.ServerScriptService.ZeroServer.Bots)
	local arena=workspace.ZeroArena
	local report={assertions=0,rays=0,routes={}}
	local function check(ok,message) assert(ok,message) report.assertions+=1 end
	local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Include params.FilterDescendantsInstances={arena}
	local function distance(a,b)
		local path=Pathfinding:CreatePath({AgentRadius=2.5,AgentHeight=6,AgentCanJump=true,WaypointSpacing=4})
		path:ComputeAsync(a,b)
		check(path.Status==Enum.PathStatus.Success,"Navigation failed: "..tostring(a).." -> "..tostring(b))
		local waypoints=path:GetWaypoints() local length=0
		for i=2,#waypoints do length+=(waypoints[i].Position-waypoints[i-1].Position).Magnitude end
		return length
	end
	check(arena:GetAttribute("LayoutVersion")==2,"correct layout")
	for _,faction in {"Alpha","Bravo"} do
		check(Layout.isSafe(Layout.spawnPosition(faction)),faction.." spawn safe")
		local doors=0
		for _,v in arena:GetChildren() do if string.find(v.Name,faction) and string.find(v.Name,"Door") then doors+=1 check(not v.CanCollide,"test requires active/open doors") end end
		check(doors==2,faction.." has two doors")
		for _,target in Layout.exitSamples(faction) do
			for _,x in {-140,-104,-48,0,48,104,140} do for _,z in {-90,-70,0,70,90} do for _,height in {5.5,15.5,24} do
				local origin=Vector3.new(x,height,z)
				check(workspace:Raycast(origin,target-origin,params)~=nil,"EXPOSED EXIT: "..faction.." "..tostring(target).." from "..tostring(origin))
				report.rays+=1 if report.rays%160==0 then task.wait() end
			end end end
		end
		for exit=1,2 do
			local route=Layout.route(faction,exit)
			local length=distance(route[1],route[7])
			local seconds=length/Layout.WalkSpeed
			check(seconds>=7 and seconds<=15,"deployment traversal outside 7–15 s budget")
			table.insert(report.routes,{team=faction,exit=exit,length=length,seconds=seconds})
		end
	end
	for i=1,2 do check(math.abs(report.routes[i].length-report.routes[i+2].length)<10,"team route parity") end
	for _,x in {-110,36,110} do
		distance(Vector3.new(x,3,-90),Vector3.new(x,3,90))
		check(workspace:Raycast(Vector3.new(x,5.5,-90),Vector3.new(0,0,180),params)~=nil,"lane has an uninterrupted 180-stud shooting corridor")
	end
	-- Real server-authoritative bot brain + real R15 targets, no spawn invulnerability.
	Bots.reset()
	for _,faction in {"Alpha","Bravo"} do
		local enemy=if faction=="Alpha" then "Bravo" else "Alpha"
		local m,b=Bots.spawn(40,faction) Bots.active[m]=nil b.stage=8 m.HumanoidRootPart.Anchored=true
		m:PivotTo(CFrame.new(0,3.2,if faction=="Alpha" then -70 else 70))
		local target=Characters.create("SpawnSightTarget",enemy,Vector3.zero) target.Parent=workspace target.HumanoidRootPart.Anchored=true
		target:SetAttribute("ProtectedUntil",0)
		for _,p in Layout.exitSamples(enemy) do
			target:PivotTo(CFrame.new(p-Vector3.new(0,1.8,0)))
			local ammo=Combat.states[m].ammo
			Bots.step(b,workspace:GetServerTimeNow(),{target}) Bots.step(b,workspace:GetServerTimeNow()+1,{target})
			check(Combat.states[m].ammo==ammo and b.target==nil,"bot targets/shoots protected deployment")
		end
		m:PivotTo(CFrame.new(0,3.2,10)) target:PivotTo(CFrame.new(0,3.2,-10))
		b.target=nil b.spottedAt=0
		Bots.step(b,workspace:GetServerTimeNow(),{target})
		for n=1,5 do Combat.states[m].lastShot=-math.huge Bots.step(b,workspace:GetServerTimeNow()+1+n,{target}) end
		check(Combat.states[m].ammo<36 and target.Humanoid.Health<275,"bot can still engage at control point")
		Characters.records[m]=nil m:Destroy() target:Destroy()
	end
	if workspace:GetAttribute("ZeroPhase")=="ACTIVE" then Bots.spawn(1) end
	print("[PROJECT ZERO] Map verification: "..report.assertions.." checks / "..report.rays.." blocked exit rays")
	return report
end
return Suite
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="145">
        <Properties>
          <string name="Name">Session.spec</string>
          <string name="Source"><![CDATA[local Suite={}
function Suite.run(player)
	local Match=require(game.ServerScriptService.ZeroServer.MatchService)
	local Combat=require(game.ServerScriptService.ZeroServer.Combat)
	local n=0
	local function check(ok,msg) assert(ok,msg) n+=1 end
	check(player:GetAttribute("ZeroSession")=="ACTIVE","test requires an active player")
	Match.buckets[player]=nil
	local m=player.Character local ammo=m:GetAttribute("Ammo")
	Match.request(player,"Inspect")
	check(player:GetAttribute("ZeroSession")=="INSPECT" and m.HumanoidRootPart.Anchored,"inspection locks server movement")
	check(not Combat.fire(m,Vector3.new(0,0,1)) and m:GetAttribute("Ammo")==ammo,"inspection blocks server fire")
	check(not Combat.dash(m,Vector3.new(1,0,0)),"inspection blocks server dash")
	Match.request(player,"Resume")
	check(player:GetAttribute("ZeroSession")=="ACTIVE" and not m.HumanoidRootPart.Anchored and m.Humanoid.WalkSpeed==22,"resume restores controls")
	Match.finishRound()
	check(player:GetAttribute("ZeroSession")=="RESULTS" and player.Character==nil,"results remove combat character")
	check(not Match.deploy(player,"VEX"),"deployment without selection rejected")
	Match.request(player,"Menu")
	check(player:GetAttribute("ZeroSession")=="MENU" and player.Character==nil,"menu has no movable character")
	Match.request(player,"Play")
	check(player:GetAttribute("ZeroSession")=="SELECT" and player.Character==nil,"play opens selection before spawn")
	check(not Match.deploy(player,"TITAN") and not Match.deploy(player,{}),"locked/invalid heroes rejected")
	check(Match.deploy(player,"VEX"),"VEX deployment accepted")
	check(player:GetAttribute("ZeroSession")=="PREPARE" and player.Character.HumanoidRootPart.Anchored,"preparation locks movement")
	check(not Combat.fire(player.Character,Vector3.new(0,0,1)),"preparation blocks combat")
	Match.request(player,"Menu")
	check(player:GetAttribute("ZeroSession")=="MENU" and player.Character==nil and workspace:GetAttribute("ZeroPhase")=="IDLE","leaving last player resets round")
	print("[PROJECT ZERO] Session verification: "..n.." checks")
	return n
end
return Suite
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="146">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">42</float>
      <float name="CharacterWalkSpeed">22</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="147">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="148">
        <Properties>
          <string name="Name">ZeroClient</string>
        </Properties>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[local Hud = {}
local WHITE, CYAN, ORANGE = Color3.fromRGB(226, 238, 244), Color3.fromRGB(74, 216, 241), Color3.fromRGB(255, 148, 65)
function Hud.create(player)
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "ZeroHUD", false, true
	gui.Parent = player:WaitForChild("PlayerGui")
	local function label(name, text, pos, size, fontSize, color, align)
		local t = Instance.new("TextLabel")
		t.Name, t.Text = name, text
		t.Position, t.Size = pos, size
		t.BackgroundTransparency, t.TextColor3 = 1, color or WHITE
		t.TextSize, t.Font = fontSize, Enum.Font.GothamBold
		t.TextXAlignment = align or Enum.TextXAlignment.Left
		t.Parent = gui
		return t
	end
	local function panel(pos, size)
		local p = Instance.new("Frame")
		p.Position, p.Size = pos, size
		p.BackgroundColor3, p.BackgroundTransparency, p.BorderSizePixel = Color3.fromRGB(13, 22, 30), .15, 0
		p.Parent = gui
		local line = Instance.new("Frame") line.Size = UDim2.new(1, 0, 0, 2) line.BackgroundColor3 = CYAN line.BorderSizePixel = 0 line.Parent = p
		return p
	end
	panel(UDim2.new(0, 28, 1, -134), UDim2.fromOffset(255, 105))
	panel(UDim2.new(1, -255, 1, -134), UDim2.fromOffset(227, 105))
	label("Brand", "PROJECT: ZERO", UDim2.fromOffset(28, 30), UDim2.fromOffset(260, 32), 25)
	label("Build", "2042 / H: HEROES / M: MAIN MENU", UDim2.fromOffset(30, 64), UDim2.fromOffset(330, 20), 11, CYAN)
	label("Map", "HAMNVERKET", UDim2.new(1, -280, 0, 32), UDim2.fromOffset(250, 30), 21, WHITE, Enum.TextXAlignment.Right)
	label("Location", "NORRHAMN  /  20:30", UDim2.new(1, -280, 0, 64), UDim2.fromOffset(250, 20), 11, CYAN, Enum.TextXAlignment.Right)
	local phase = label("Phase", "PREPARE", UDim2.new(.5, -220, 0, 35), UDim2.fromOffset(440, 32), 19, ORANGE, Enum.TextXAlignment.Center)
	local info = label("Info", "TRAINING DEATHMATCH", UDim2.new(.5, -240, 0, 70), UDim2.fromOffset(480, 20), 11, WHITE, Enum.TextXAlignment.Center)
	label("Hero", "VEX  /  DAMAGE", UDim2.new(0, 46, 1, -122), UDim2.fromOffset(220, 22), 14, CYAN)
	local health = label("Health", "275", UDim2.new(0, 46, 1, -97), UDim2.fromOffset(115, 43), 37)
	label("MaxHealth", "/ 275 HP", UDim2.new(0, 142, 1, -82), UDim2.fromOffset(120, 22), 13)
	local healthBg = Instance.new("Frame") healthBg.Position = UDim2.new(0, 46, 1, -48) healthBg.Size = UDim2.fromOffset(218, 6) healthBg.BackgroundColor3 = Color3.fromRGB(45, 64, 73) healthBg.BorderSizePixel = 0 healthBg.Parent = gui
	local healthBar = Instance.new("Frame") healthBar.Size = UDim2.fromScale(1, 1) healthBar.BackgroundColor3 = CYAN healthBar.BorderSizePixel = 0 healthBar.Parent = healthBg
	label("Weapon", "VX-7  /  ASSAULT RIFLE", UDim2.new(1, -237, 1, -122), UDim2.fromOffset(200, 22), 12, ORANGE)
	local ammo = label("Ammo", "36", UDim2.new(1, -237, 1, -97), UDim2.fromOffset(110, 43), 37)
	label("MaxAmmo", "/ 36", UDim2.new(1, -142, 1, -82), UDim2.fromOffset(75, 22), 16)
	local reload = label("Reload", "R  RELOAD", UDim2.new(1, -237, 1, -51), UDim2.fromOffset(200, 18), 11, ORANGE)
	local dash = label("Dash", "Q  DASH  /  READY", UDim2.new(.5, -150, 1, -89), UDim2.fromOffset(300, 28), 17, CYAN, Enum.TextXAlignment.Center)
	label("FutureAbilities", "PULSE GRENADE  /  OVERDRIVE  [LOCKED]", UDim2.new(.5, -210, 1, -57), UDim2.fromOffset(420, 18), 10, Color3.fromRGB(143, 159, 171), Enum.TextXAlignment.Center)
	label("Controls", "WASD  MOVE     MOUSE  AIM / FIRE     SPACE  JUMP", UDim2.new(.5, -260, 1, -29), UDim2.fromOffset(520, 16), 10, WHITE, Enum.TextXAlignment.Center)
	local crosshair = Instance.new("Frame") crosshair.Name = "Crosshair" crosshair.Size = UDim2.fromOffset(2, 2) crosshair.Position = UDim2.fromScale(.5, .5) crosshair.BackgroundTransparency = 1 crosshair.Parent = gui
	for _, data in {{-12, 0, 7, 2}, {6, 0, 7, 2}, {0, -12, 2, 7}, {0, 6, 2, 7}} do
		local line = Instance.new("Frame") line.Position = UDim2.fromOffset(data[1], data[2]) line.Size = UDim2.fromOffset(data[3], data[4]) line.BorderSizePixel = 0 line.BackgroundColor3 = WHITE line.Parent = crosshair
	end
	local hit = label("Hit", "×", UDim2.new(.5, -20, .5, -20), UDim2.fromOffset(40, 40), 36, ORANGE, Enum.TextXAlignment.Center) hit.Visible = false
	local death = label("Death", "", UDim2.new(.5, -300, .5, 60), UDim2.fromOffset(600, 70), 24, ORANGE, Enum.TextXAlignment.Center)
	return {gui = gui, health = health, healthBar = healthBar, ammo = ammo, reload = reload, dash = dash, phase = phase, info = info, hit = hit, death = death}
end
return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="150">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local C = require(game.ReplicatedStorage.ZeroShared.Config)
local G = require(game.ReplicatedStorage.ZeroShared.Geometry)
local Hud = require(script.Parent.Hud)
local player = Players.LocalPlayer
local remotes = game.ReplicatedStorage:WaitForChild("ZeroRemotes")
local hud = Hud.create(player)
local menu = require(script.Parent.MainMenu).create(player, remotes:WaitForChild("Flow"))
local Layout = require(game.ReplicatedStorage.ZeroShared.MapLayout)
local Pose = require(game.ReplicatedStorage.ZeroShared.AnimationPose)
local character, humanoid, viewmodel
local ammo, localReloadEnd, nextShot, recoil, hitUntil = 36, 0, 0, 0, 0
local holding = false
local yaw, pitch = 0, 0
local shotSound = Instance.new("Sound") shotSound.SoundId = C.ShotSound shotSound.Volume = .35 shotSound.Parent = SoundService
local tickSound = Instance.new("Sound") tickSound.SoundId = "rbxasset://sounds/button.wav" tickSound.Volume = .15 tickSound.Parent = SoundService
shotSound.SoundGroup = SoundService:WaitForChild("ZeroAudio")
tickSound.SoundGroup = shotSound.SoundGroup
workspace:GetAttributeChangedSignal("ZeroPhase"):Connect(function() tickSound:Play() end)
local fxFolder = Instance.new("Folder") fxFolder.Name = "ZeroLocalFX" fxFolder.Parent = workspace
local visualShots = setmetatable({}, {__mode = "k"})
local function makeViewmodel()
	if viewmodel then viewmodel:Destroy() end
	viewmodel = Instance.new("Model") viewmodel.Name = "VEX_FirstPerson"
	local root = G.part(viewmodel, "Root", Vector3.one * .1, CFrame.identity, Color3.new()) root.Transparency = 1
	viewmodel.PrimaryPart = root
	local rifle = G.rifle(viewmodel)
	rifle:PivotTo(CFrame.new(.62, -.5, -1.1))
	G.part(viewmodel, "RightGlove", Vector3.new(.33, .35, .48), CFrame.new(.63, -.83, -.7), Color3.fromRGB(29, 34, 41))
	G.part(viewmodel, "RightArm", Vector3.new(.38, .4, 1.15), CFrame.new(.68, -.92, -.05) * CFrame.Angles(-.15, 0, 0), Color3.fromRGB(48, 55, 64))
	G.part(viewmodel, "LeftArm", Vector3.new(.38, .4, 1.25), CFrame.new(.05, -.89, -1.04) * CFrame.Angles(-.2, -.8, -.15), Color3.fromRGB(48, 55, 64))
	local art=game.ReplicatedStorage.ZeroAssets:FindFirstChild("HeroArt")
	local common=art and art:FindFirstChild("Common")
	if common and common:FindFirstChild("Forearm") then
		for _,side in {"Left","Right"} do
			local sleeve=require(game.ReplicatedStorage.ZeroShared.ArmorFit).equip(common.Forearm,viewmodel,side.."Arm",side.."Sleeve",Vector3.new(.43,1,.43),CFrame.Angles(math.pi/2,0,0))
			for _,p in sleeve:GetDescendants() do if p:IsA("BasePart") then p.Color=Color3.fromRGB(64,69,77) end end
		end
	end
	for _, p in viewmodel:GetDescendants() do
		if p:IsA("BasePart") then p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false end
	end
	viewmodel.Parent = workspace.CurrentCamera
end
local ammoConnection
local function attach(m)
	local nextHumanoid=m:WaitForChild("Humanoid",5)
	local root=m:WaitForChild("HumanoidRootPart",5)
	-- A rapid menu/deployment transition may remove a replicated model mid-attach.
	if not nextHumanoid or not root or player.Character~=m then return end
	character,humanoid = m,nextHumanoid
	workspace.CurrentCamera.CameraSubject = humanoid
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	workspace.CurrentCamera.FieldOfView = 80
	yaw, pitch = math.atan2(-root.CFrame.LookVector.X, -root.CFrame.LookVector.Z), 0
	workspace.CurrentCamera.CFrame = CFrame.lookAt(m.Head.Position, m.Head.Position + root.CFrame.LookVector * 30)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	UserInputService.MouseIconEnabled = false
	ammo, localReloadEnd, nextShot, recoil, holding = m:GetAttribute("Ammo") or 36, 0, 0, 0, false
	if ammoConnection then ammoConnection:Disconnect() end
	ammoConnection = m:GetAttributeChangedSignal("Ammo"):Connect(function() ammo = m:GetAttribute("Ammo") or 0 end)
	makeViewmodel()
end
player.CharacterAdded:Connect(attach)
if player.Character then task.spawn(attach, player.Character) end
player.CharacterRemoving:Connect(function(m)
	if character ~= m then return end
	character, humanoid, holding = nil, nil, false
	if viewmodel then viewmodel:Destroy() viewmodel = nil end
	if ammoConnection then ammoConnection:Disconnect() ammoConnection = nil end
end)
local function reload()
	if not humanoid or humanoid.Health <= 0 or ammo == 36 or workspace:GetServerTimeNow() < localReloadEnd then return end
	localReloadEnd = workspace:GetServerTimeNow() + C.Weapon.ReloadTime
	remotes.Action:FireServer("Reload")
	tickSound:Play()
end
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or menu.isOpen or player:GetAttribute("ZeroSession") ~= "ACTIVE" then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then holding = true
	elseif input.KeyCode == Enum.KeyCode.R then reload()
	elseif input.KeyCode == Enum.KeyCode.Q and humanoid and humanoid.Health > 0 then
		local d = humanoid.MoveDirection
		if d.Magnitude < .1 then d = workspace.CurrentCamera.CFrame.LookVector end
		remotes.Action:FireServer("Dash", d.Unit)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then holding = false end
end)
UserInputService.WindowFocusReleased:Connect(function() holding = false end)
local function tracer(origin, endpoint, color)
	local delta = endpoint - origin
	if delta.Magnitude < .05 then return end
	local p = G.part(fxFolder, "Tracer", Vector3.new(.035, .035, delta.Magnitude), CFrame.lookAt((origin + endpoint) / 2, endpoint), color, Enum.Material.Neon)
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	Debris:AddItem(p, .055)
	local impact = G.part(fxFolder, "Impact", Vector3.one * .16, CFrame.new(endpoint), color, Enum.Material.Neon)
	impact.CanCollide, impact.CanQuery, impact.CanTouch = false, false, false
	Debris:AddItem(impact, .1)
end
remotes.FX.OnClientEvent:Connect(function(shooter, origin, endpoint, hit, headshot, killed)
	if shooter then visualShots[shooter] = os.clock() end
	tracer(origin, endpoint, if shooter == character then Color3.fromRGB(255, 173, 73) else Color3.fromRGB(255, 83, 48))
	if shooter == character then
		if hit then
			hitUntil = os.clock() + .16
			hud.hit.TextColor3 = if killed then Color3.fromRGB(255, 58, 63) elseif headshot then Color3.fromRGB(255, 178, 55) else Color3.new(1, 1, 1)
			tickSound:Play()
		end
	elseif shooter and shooter:FindFirstChild("Head") then
		local sound = shotSound:Clone() sound.Volume = .2 sound.RollOffMaxDistance = 220 sound.Parent = shooter.Head sound:Play() Debris:AddItem(sound, 2)
	end
end)
RunService:BindToRenderStep("ZeroFPS", Enum.RenderPriority.Camera.Value + 1, function(dt)
	hud.gui.Enabled = not menu.isOpen and character ~= nil
	if menu.isOpen then holding = false end
	local time = workspace:GetServerTimeNow()
	local alive = humanoid and humanoid.Health > 0
	local phase = workspace:GetAttribute("ZeroPhase")
	hud.phase.Text = if phase == "PREPARE" then "PREPARE  /  " .. math.max(0, math.ceil((workspace:GetAttribute("ZeroPhaseEnd") or time) - time)) else "TRAINING  /  LIVE"
	hud.info.Text = if phase == "PREPARE" then "VEX ONLINE  •  DOORS OPEN AT ZERO" else "ALPHA vs BRAVO  /  ELIMINATE HOSTILES"
	if phase == "ACTIVE" then
		local remaining = math.max(0, math.ceil((workspace:GetAttribute("ZeroRoundEnd") or time) - time))
		hud.info.Text = string.format("TRAINING  %d:%02d  /  M: MAIN MENU", math.floor(remaining / 60), remaining % 60)
	end
	hud.hit.Visible = os.clock() < hitUntil
	if not character or not humanoid then return end
	local active = player:GetAttribute("ZeroSession") == "ACTIVE"
	if not menu.isOpen and humanoid.Health > 0 then
		local delta = UserInputService:GetMouseDelta()
		local sensitivity = player:GetAttribute("ZeroAimSensitivity") or 1
		yaw -= delta.X * .002 * sensitivity
		pitch = math.clamp(pitch - delta.Y * .002 * sensitivity, -1.4, 1.4)
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
		workspace.CurrentCamera.CFrame = CFrame.new(character.Head.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		if active then humanoid.AutoRotate = false character.HumanoidRootPart.CFrame = CFrame.new(character.HumanoidRootPart.Position) * CFrame.Angles(0, yaw, 0) end
	end
	hud.health.Text = tostring(math.ceil(humanoid.Health))
	hud.healthBar.Size = UDim2.fromScale(math.clamp(humanoid.Health / C.MaxHealth, 0, 1), 1)
	hud.ammo.Text = string.format("%02d", ammo)
	local serverReload = character:GetAttribute("ReloadEnd") or 0
	local reloading = time < math.max(serverReload, localReloadEnd)
	hud.reload.Text = if reloading then "RELOADING  " .. string.format("%.1f", math.max(serverReload, localReloadEnd) - time) .. "s" else "R  RELOAD"
	local cooldown = math.max(0, (character:GetAttribute("DashReadyAt") or 0) - time)
	hud.dash.Text = if cooldown > 0 then "Q  DASH  /  " .. string.format("%.1fs", cooldown) else "Q  DASH  /  READY"
	local respawnAt = character:GetAttribute("RespawnAt") or time
	hud.death.Text = if not alive then "VEX DOWN\nREDEPLOY IN " .. math.max(0, math.ceil(respawnAt - time)) .. "s" elseif Layout.isSafe(character.HumanoidRootPart.Position) then "SPAWN PROTECTED" else ""
	if holding and alive and active and not reloading and phase == "ACTIVE" and time >= nextShot and not Layout.isSafe(character.HumanoidRootPart.Position) then
		if ammo > 0 then
			nextShot = time + C.Weapon.FireInterval
			ammo -= 1
			remotes.Action:FireServer("Fire", workspace.CurrentCamera.CFrame.LookVector)
			recoil = math.min(.16, recoil + .045)
			pitch = math.min(1.4, pitch + math.rad(.45))
			shotSound.PlaybackSpeed = .96 + math.random() * .08 shotSound:Play()
			local muzzle = viewmodel and viewmodel:FindFirstChild("VX7") and viewmodel.VX7:FindFirstChild("Barrel")
			if muzzle and not player:GetAttribute("ZeroReducedEffects") then
				local flash = Instance.new("PointLight") flash.Color = Color3.fromRGB(255, 181, 81) flash.Brightness = 2 flash.Range = 8 flash.Parent = muzzle Debris:AddItem(flash, .04)
			end
		else reload() end
	end
	recoil *= math.exp(-dt * 16)
	if viewmodel then
		viewmodel.Parent = if alive and not menu.isOpen then workspace.CurrentCamera else nil
		local bob = math.sin(os.clock() * 10) * math.min(humanoid.MoveDirection.Magnitude, 1) * .025
		local tilt = if reloading then math.sin(math.clamp(1 - (math.max(serverReload, localReloadEnd) - time) / C.Weapon.ReloadTime, 0, 1) * math.pi) else 0
		viewmodel:PivotTo(workspace.CurrentCamera.CFrame * CFrame.new(0, bob - tilt * .35, recoil) * CFrame.Angles(tilt * -.4, 0, tilt * -.65))
	end
	for _, p in character:GetDescendants() do if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 end end
end)
-- Shared motion poses also drive all eight armory previews.
local gaitClock = 0
RunService.Heartbeat:Connect(function(dt)
	gaitClock += dt
	if gaitClock < .05 then return end
	gaitClock = 0
	for _, m in workspace:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("Hero") and m:FindFirstChild("HumanoidRootPart") then
			local speed = m.HumanoidRootPart.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
			local elapsed = os.clock() - (visualShots[m] or -100)
			local reloadEnd = m:GetAttribute("ReloadEnd") or 0
			local remaining = reloadEnd - workspace:GetServerTimeNow()
			local action = if remaining > 0 then "Reload" elseif elapsed < .2 then "Fire" else "Idle"
			Pose.apply(m, os.clock(), speed.Magnitude / C.WalkSpeed, action, if action == "Reload" then 1 - remaining / C.Weapon.ReloadTime else elapsed / .2)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">MainMenu</string>
            <string name="Source"><![CDATA[local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local UIS=game:GetService("UserInputService")
local SoundService=game:GetService("SoundService")
local Catalog=require(game.ReplicatedStorage.ZeroShared.HeroCatalog)
local Factory=require(game.ReplicatedStorage.ZeroShared.RigFactory)
local Weapons=require(game.ReplicatedStorage.ZeroShared.HeroWeapons)
local Pose=require(game.ReplicatedStorage.ZeroShared.AnimationPose)
local G=require(game.ReplicatedStorage.ZeroShared.Geometry)
local Menu={}
function Menu.create(player,flow)
 local self={isOpen=true,page="HOME",selected="VEX",pose="Idle",poseAt=0,orbit=0,zoom=1}
 local white,muted,orange=Color3.fromRGB(223,231,237),Color3.fromRGB(145,163,178),Color3.fromRGB(221,137,69)
 local gui=Instance.new("ScreenGui") gui.Name="ZeroMainMenu" gui.IgnoreGuiInset=true gui.ResetOnSpawn=false gui.DisplayOrder=30 gui.Parent=player:WaitForChild("PlayerGui")
 local bg=Instance.new("Frame") bg.Name="Backdrop" bg.Size=UDim2.fromScale(1,1) bg.BackgroundColor3=Color3.fromRGB(13,22,31) bg.BorderSizePixel=0 bg.Parent=gui
 local viewport=Instance.new("ViewportFrame") viewport.Name="Scene" viewport.BackgroundTransparency=1 viewport.Position=UDim2.fromScale(.35,.1) viewport.Size=UDim2.fromScale(.65,.9) viewport.Ambient=Color3.fromRGB(130,149,171) viewport.LightColor=Color3.fromRGB(216,195,173) viewport.LightDirection=Vector3.new(-1,-1,-2) viewport.Parent=bg
 local world=Instance.new("WorldModel") world.Parent=viewport
 local camera=Instance.new("Camera") camera.FieldOfView=37 camera.Parent=viewport viewport.CurrentCamera=camera
 local stage=Instance.new("Model") stage.Name="IndustrialStage" stage.Parent=world
 G.part(stage,"Floor",Vector3.new(28,.5,24),CFrame.new(0,-.3,0),Color3.fromRGB(36,48,59),Enum.Material.Concrete)
 G.part(stage,"TerminalWall",Vector3.new(26,15,1),CFrame.new(0,7,5),Color3.fromRGB(46,59,70),Enum.Material.Metal)
 for _,x in {-8,8} do
  G.part(stage,"StructuralColumn",Vector3.new(.7,15,2),CFrame.new(x,7,4.5),Color3.fromRGB(86,103,115),Enum.Material.Metal)
  G.part(stage,"WarningStrip",Vector3.new(.12,7,.1),CFrame.new(x,5,3.4),Color3.fromRGB(142,83,32),Enum.Material.Neon)
 end
 for n=1,7 do G.part(stage,"Shutter",Vector3.new(12,.15,.3),CFrame.new(0,n*1.5,4.3),Color3.fromRGB(29,42,54),Enum.Material.Metal) end
 local subject
 local function text(parent,name,value,pos,size,color,max)
  local l=Instance.new("TextLabel") l.Name=name l.Text=value l.Position=pos l.Size=size l.BackgroundTransparency=1 l.Font=Enum.Font.GothamBold l.TextColor3=color or white l.TextScaled=true l.TextXAlignment=Enum.TextXAlignment.Left l.TextYAlignment=Enum.TextYAlignment.Center l.Parent=parent
  l.TextWrapped=true
  local limit=Instance.new("UITextSizeConstraint") limit.MaxTextSize=max or 22 limit.MinTextSize=9 limit.Parent=l return l
 end
 local content=Instance.new("Frame") content.Name="Content" content.Size=UDim2.fromScale(1,1) content.BackgroundTransparency=1 content.Parent=bg
 local pages={}
 for _,name in {"HOME","PLAY","HEROES","ARMORY","SETTINGS","CREDITS","SELECT","RESULTS"} do local f=Instance.new("Frame") f.Name=name f.Size=UDim2.fromScale(1,1) f.BackgroundTransparency=1 f.Visible=false f.Parent=content pages[name]=f end
 local header=text(bg,"Logo","PROJECT: ZERO",UDim2.fromScale(.055,.065),UDim2.fromScale(.85,.105),white,76)
 header.RichText=true
 local sub=text(bg,"Subtitle","NORRHAMN  /  2042  /  ZERO INITIATIVE",UDim2.fromScale(.058,.17),UDim2.fromScale(.82,.04),orange,14)
 local footer=text(bg,"Footer","TRAINING PROTOTYPE   •   HAMNVERKET",UDim2.fromScale(.055,.95),UDim2.fromScale(.8,.025),muted,11)
 local fade=Instance.new("Frame") fade.Name="Transition" fade.Size=UDim2.fromScale(1,1) fade.BackgroundColor3=bg.BackgroundColor3 fade.BackgroundTransparency=1 fade.BorderSizePixel=0 fade.ZIndex=40 fade.Parent=bg
 local group=SoundService:FindFirstChild("ZeroAudio") or Instance.new("SoundGroup") group.Name="ZeroAudio" group.Volume=.7 group.Parent=SoundService
 local click=Instance.new("Sound") click.Name="ZeroMenuClick" click.SoundId="rbxasset://sounds/button.wav" click.Volume=.1 click.SoundGroup=group click.Parent=SoundService
 player:SetAttribute("ZeroAimSensitivity",1) player:SetAttribute("ZeroReducedEffects",false)
 local function button(parent,name,value,pos,size,callback,locked)
  local b=Instance.new("TextButton") b.Name=name b.Text="  "..value b.Position=pos b.Size=size b.BackgroundColor3=Color3.fromRGB(30,45,59) b.BackgroundTransparency=.1 b.BorderSizePixel=0 b.TextColor3=if locked then muted else white b.Font=Enum.Font.GothamBold b.TextScaled=true b.TextXAlignment=Enum.TextXAlignment.Left b.AutoButtonColor=false b.Selectable=not locked b.Active=not locked b.Parent=parent
  local limit=Instance.new("UITextSizeConstraint") limit.MaxTextSize=22 limit.MinTextSize=9 limit.Parent=b
  local stroke=Instance.new("UIStroke") stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border stroke.Color=Color3.fromRGB(66,86,102) stroke.Transparency=.4 stroke.Parent=b
  if not locked then
   b.MouseEnter:Connect(function() TweenService:Create(b,TweenInfo.new(.16),{BackgroundColor3=Color3.fromRGB(65,73,77),TextColor3=orange}):Play() end)
   b.MouseLeave:Connect(function() TweenService:Create(b,TweenInfo.new(.18),{BackgroundColor3=Color3.fromRGB(30,45,59),TextColor3=white}):Play() end)
   b.Activated:Connect(function() click:Play() callback() end)
  end
  return b
 end
 local show,choose
 local back=button(bg,"Back","←  BACK",UDim2.fromScale(.055,.88),UDim2.fromScale(.22,.052),function()
  local s=player:GetAttribute("ZeroSession")
  if s=="INSPECT" then flow:FireServer("Resume") elseif s=="SELECT" then flow:FireServer("Menu") else show("HOME") end
 end)
 local nav=Instance.new("Frame") nav.Name="Navigation" nav.Position=UDim2.fromScale(.055,.32) nav.Size=UDim2.fromScale(.34,.54) nav.BackgroundTransparency=1 nav.Parent=pages.HOME
 for i,name in {"PLAY","HEROES","ARMORY","SETTINGS","CREDITS"} do button(nav,"Nav_"..name,name,UDim2.fromScale(0,(i-1)*.19),UDim2.fromScale(1,.15),function() show(name) end) end
 text(pages.HOME,"Tagline","HUMAN OPERATIVES.\nADVANCED WARFARE.",UDim2.fromScale(.6,.78),UDim2.fromScale(.34,.12),muted,21)
 text(pages.PLAY,"Title","SELECT OPERATION",UDim2.fromScale(.055,.29),UDim2.fromScale(.6,.06),white,32)
 button(pages.PLAY,"Training","TRAINING  /  VEX vs AI",UDim2.fromScale(.055,.4),UDim2.fromScale(.42,.1),function() flow:FireServer("Play") end)
 text(pages.PLAY,"TrainingInfo","HAMNVERKET • 3-minute training round\n30-second hero selection • 15-second preparation",UDim2.fromScale(.058,.52),UDim2.fromScale(.43,.11),muted,18)
 button(pages.PLAY,"MultiplayerLocked","MULTIPLAYER  /  COMING SOON",UDim2.fromScale(.055,.67),UDim2.fromScale(.42,.07),nil,true)
 button(pages.PLAY,"ControlLocked","CONTROL / ESCORT  /  LOCKED",UDim2.fromScale(.055,.77),UDim2.fromScale(.42,.07),nil,true)
 local heroFrames={}
 for _,mode in {"HEROES","ARMORY","SELECT"} do
  local f=pages[mode]
  local cards=Instance.new("Frame") cards.Name="Cards" cards.BackgroundTransparency=1 cards.Position=UDim2.fromScale(.055,.29) cards.Size=UDim2.fromScale(.23,.55) cards.Parent=f
  for i,id in Catalog.Order do button(cards,"Hero_"..id,id..(if id=="VEX" then "" else "  / PREVIEW"),UDim2.fromScale(0,(i-1)*.125),UDim2.fromScale(1,.105),function() choose(id) end) end
  local info=text(f,"HeroInfo","",UDim2.fromScale(.73,.3),UDim2.fromScale(.235,.4),white,24)
  local status=text(f,"HeroStatus","",UDim2.fromScale(.73,.71),UDim2.fromScale(.235,.12),orange,16)
  local inspect=Instance.new("Frame") inspect.Name="Inspect" inspect.BackgroundTransparency=1 inspect.Position=UDim2.fromScale(.32,.78) inspect.Size=UDim2.fromScale(.39,.045) inspect.Parent=f
  for i,d in {{"RotateLeft","LEFT",-.4,0},{"RotateRight","RIGHT",.4,0},{"ZoomIn","+",0,-.15},{"ZoomOut","−",0,.15},{"ResetView","RESET",0,0}} do
   button(inspect,d[1],d[2],UDim2.fromScale((i-1)*.2,0),UDim2.fromScale(.185,1),function()
    if d[1]=="ResetView" then self.orbit,self.zoom=0,1 else self.orbit+=d[3] self.zoom=math.clamp(self.zoom+d[4],.65,1.45) end
    gui:SetAttribute("InspectYaw",self.orbit) gui:SetAttribute("InspectZoom",self.zoom)
   end)
  end
  local poses=Instance.new("Frame") poses.Name="Poses" poses.BackgroundTransparency=1 poses.Position=UDim2.fromScale(.32,.84) poses.Size=UDim2.fromScale(.39,.045) poses.Parent=f
  for i,a in {"Idle","Run","Fire","Reload"} do button(poses,"Pose_"..a,a,UDim2.fromScale((i-1)*.25,0),UDim2.fromScale(.235,1),function() self.pose=a self.poseAt=os.clock() gui:SetAttribute("PreviewAction",a) end) end
  heroFrames[mode]={cards=cards,info=info,status=status,poses=poses}
 end
 local deploy=button(pages.SELECT,"Deploy","DEPLOY VEX",UDim2.fromScale(.73,.85),UDim2.fromScale(.235,.065),function() if self.selected=="VEX" then flow:FireServer("Deploy","VEX") end end)
 local timer=text(pages.SELECT,"SelectTimer","",UDim2.fromScale(.055,.23),UDim2.fromScale(.8,.04),orange,18)
 local settings=pages.SETTINGS
 text(settings,"Title","FIELD SETTINGS",UDim2.fromScale(.055,.29),UDim2.fromScale(.65,.065),white,32)
 local volume=text(settings,"VolumeValue","",UDim2.fromScale(.055,.4),UDim2.fromScale(.47,.06),white,23)
 local sensitivity=text(settings,"SensitivityValue","",UDim2.fromScale(.055,.53),UDim2.fromScale(.47,.06),white,23)
 local quality=text(settings,"QualityValue","",UDim2.fromScale(.055,.66),UDim2.fromScale(.47,.06),white,23)
 local function refreshSettings()
  volume.Text="MASTER AUDIO  /  "..math.floor(group.Volume*100+.5).."%"
  sensitivity.Text=string.format("FPS AIM  /  %.1f ×",player:GetAttribute("ZeroAimSensitivity"))
  quality.Text="LOCAL EFFECTS  /  "..(if player:GetAttribute("ZeroReducedEffects") then "LOW" else "HIGH")
 end
 for _,d in {{"VolumeMinus",.4,-.1},{"VolumePlus",.4,.1},{"SensitivityMinus",.53,-.1},{"SensitivityPlus",.53,.1}} do
  local name,y,delta=d[1],d[2],d[3]
  button(settings,name,if delta<0 then "  −" else "  +",UDim2.fromScale(if delta<0 then .55 else .65,y),UDim2.fromScale(.08,.065),function()
   if string.find(name,"Volume") then group.Volume=math.clamp(group.Volume+delta,0,1) else player:SetAttribute("ZeroAimSensitivity",math.clamp(player:GetAttribute("ZeroAimSensitivity")+delta,.2,2)) end refreshSettings()
  end)
 end
 button(settings,"QualityToggle","TOGGLE",UDim2.fromScale(.55,.66),UDim2.fromScale(.18,.065),function()
  local low=not player:GetAttribute("ZeroReducedEffects") player:SetAttribute("ZeroReducedEffects",low) game.Lighting.GlobalShadows=not low refreshSettings()
 end)
 text(settings,"SettingsNote","Applies this session. FPS aim controls this game's camera.\nLOW reduces local effects and shadows. Roblox device quality stays in Roblox settings.",UDim2.fromScale(.055,.77),UDim2.fromScale(.69,.075),muted,15)
 text(pages.CREDITS,"Credits","PROJECT: ZERO\nAn original Roblox hero-shooter prototype\n\nNORRHAMN / 2042 • ZERO INITIATIVE\nLuau, Rojo and fitted human R15 models\nArmor meshes created with Roblox AI, then reviewed and adapted\n\nPoly Haven / Jorge Camacho: CC0 industrial pipes\nCreator Store: Elttob, DesiredDestinyx1, circles_squared\nSources, AI provenance and terms: repository docs/ASSETS.md\n\nVisual prototype • only VEX currently playable",UDim2.fromScale(.055,.29),UDim2.fromScale(.66,.53),white,23)
 local results=text(pages.RESULTS,"Results","",UDim2.fromScale(.055,.32),UDim2.fromScale(.53,.3),white,34)
 button(pages.RESULTS,"ReturnMenu","RETURN TO MAIN MENU",UDim2.fromScale(.055,.68),UDim2.fromScale(.43,.08),function() flow:FireServer("Menu") end)
 button(pages.RESULTS,"PlayAgain","PLAY AGAIN",UDim2.fromScale(.055,.79),UDim2.fromScale(.43,.065),function() flow:FireServer("Play") end)
 choose=function(id)
  local nextSubject=if self.page=="ARMORY" then Weapons.create(id,world,true) else Factory.create(id.."_Menu","Alpha",Vector3.zero,id)
  if subject then subject:Destroy() end subject=nextSubject subject.Parent=world self.selected=id self.orbit,self.zoom=0,1 gui:SetAttribute("SelectedHero",id)
  gui:SetAttribute("InspectYaw",0) gui:SetAttribute("InspectZoom",1)
  if self.page=="ARMORY" then for _,p in subject:GetDescendants() do if p:IsA("BasePart") then p.Anchored=true p.CanCollide=false end end subject:ScaleTo(2.5)
  else for _,p in subject:GetDescendants() do if p:IsA("BasePart") then p.Anchored=p.Name=="HumanoidRootPart" p.CanCollide=false end end end
  local h=Catalog.Heroes[id]
  for _,f in heroFrames do
   f.info.Text=id.."\n"..h.Role.." / "..h.HP.." HP\n\n"..h.Name.."\n"..h.Weapon
   f.status.Text=if id=="VEX" then "PLAYABLE\nVX-7 + Dash\nGrenade / ultimate pending" else "VISUAL PREVIEW\nGameplay kit locked\n"..h.Kit
  end
  deploy.Text=if id=="VEX" then "  DEPLOY VEX" else "  KIT LOCKED / PREVIEW ONLY" deploy.Active=id=="VEX" deploy.Selectable=id=="VEX"
  heroFrames.ARMORY.status.Text=h.Silhouette.."\n\nPLANNED KIT: "..h.Kit
 end
 local function responsive()
  local narrow=gui.AbsoluteSize.X<700
  for _,f in heroFrames do
   f.cards.Position=if narrow then UDim2.fromScale(.055,.27) else UDim2.fromScale(.055,.29)
   f.cards.Size=if narrow then UDim2.fromScale(.25,.56) else UDim2.fromScale(.23,.55)
   f.info.Position=UDim2.fromScale(.73,.3) f.info.Size=UDim2.fromScale(.235,.4)
  end
  nav.Size=UDim2.fromScale(if narrow then .43 else .34,.54)
 end
 show=function(page)
  self.page=page gui:SetAttribute("Page",page)
  for name,f in pages do f.Visible=name==page end
  back.Visible=page~="HOME" and page~="RESULTS"
  header.Text=if page=="HOME" then 'PROJECT: <font color="#DD8945">ZERO</font>' elseif page=="SELECT" then "CHOOSE YOUR OPERATIVE" else "ZERO // "..page
  sub.Text=if page=="HOME" then "NORRHAMN / 2042 / ZERO INITIATIVE" else "HAMNVERKET / OPERATIVE COMMAND"
  viewport.Visible=page=="HOME" or page=="PLAY" or heroFrames[page]~=nil or page=="RESULTS"
  viewport.Position=if heroFrames[page] then UDim2.fromScale(.29,.24) else UDim2.fromScale(.38,.15)
  viewport.Size=if heroFrames[page] then UDim2.fromScale(.43,.59) else UDim2.fromScale(.62,.8)
  if page=="HOME" or page=="PLAY" or page=="RESULTS" then choose("VEX") elseif heroFrames[page] then choose(self.selected) end
  if page=="RESULTS" then results.Text="TRAINING COMPLETE\n\n"..(player:GetAttribute("ZeroResultKills") or 0).." ELIMINATIONS\n"..(player:GetAttribute("ZeroResultDeaths") or 0).." DEATHS" end
  heroFrames.ARMORY.poses.Visible=false
  fade.BackgroundTransparency=.4 TweenService:Create(fade,TweenInfo.new(.25),{BackgroundTransparency=1}):Play()
  refreshSettings() responsive()
 end
 local function sync()
  local s=player:GetAttribute("ZeroSession") or "MENU"
  self.isOpen=s=="MENU" or s=="SELECT" or s=="RESULTS" or s=="INSPECT" gui.Enabled=self.isOpen
  if self.isOpen then workspace.CurrentCamera.CameraType=Enum.CameraType.Scriptable UIS.MouseBehavior=Enum.MouseBehavior.Default UIS.MouseIconEnabled=true
   show(if s=="SELECT" then "SELECT" elseif s=="RESULTS" then "RESULTS" elseif s=="INSPECT" then "HEROES" else "HOME")
  else UIS.MouseIconEnabled=false end
 end
 player:GetAttributeChangedSignal("ZeroSession"):Connect(sync)
 gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(responsive)
 UIS.InputBegan:Connect(function(input,processed)
  if processed then return end
  if input.KeyCode==Enum.KeyCode.M then flow:FireServer("Menu")
  elseif input.KeyCode==Enum.KeyCode.H and player:GetAttribute("ZeroSession")=="ACTIVE" then flow:FireServer("Inspect") end
 end)
 RunService:BindToRenderStep("ZeroMainMenu",Enum.RenderPriority.Camera.Value+3,function(dt)
  if not self.isOpen then return end
  UIS.MouseBehavior=Enum.MouseBehavior.Default UIS.MouseIconEnabled=true workspace.CurrentCamera.CameraType=Enum.CameraType.Scriptable
  if self.page=="SELECT" then timer.Text="VEX AVAILABLE / OTHER KITS LOCKED  •  AUTO-DEPLOY IN "..math.max(0,math.ceil((player:GetAttribute("ZeroSelectEnd") or workspace:GetServerTimeNow())-workspace:GetServerTimeNow())).."s" end
  if not subject then return end
  local aspect=math.max(.15,viewport.AbsoluteSize.X/math.max(1,viewport.AbsoluteSize.Y))
  camera.FieldOfView=math.clamp(math.deg(2*math.atan(math.tan(math.rad(18.5))*math.max(1,.8/aspect))),37,82)
  if self.page=="ARMORY" then
   subject:PivotTo(CFrame.new(0,2,0)*CFrame.Angles(0,self.orbit+1.2+math.sin(os.clock()*.25)*.25,0))
   local center,size=subject:GetBoundingBox()
   local distance=math.max(10,size.Magnitude*.65/math.tan(math.rad(camera.FieldOfView/2))*math.max(1,1/aspect))
   camera.CFrame=CFrame.lookAt(center.Position+Vector3.new(0,1,-distance*self.zoom),center.Position)
  else
   subject.HumanoidRootPart.CFrame=CFrame.new(0,3.1,0)*CFrame.Angles(0,self.orbit-.18+math.sin(os.clock()*.22)*.08,0)
   local elapsed=os.clock()-self.poseAt local progress=if self.pose=="Reload" then (elapsed%2.5)/1.8 else (elapsed%.5)/.2
   Pose.apply(subject,os.clock(),if self.pose=="Run" and heroFrames[self.page] then 1 else 0,if heroFrames[self.page] then self.pose else "Idle",progress)
   local distance=14*Catalog.Heroes[self.selected].Scale*self.zoom*math.max(1,.72/aspect)
   camera.CFrame=CFrame.lookAt(Vector3.new(distance*.32,4.2,-distance),Vector3.new(0,2.8,0))
  end
 end)
 sync()
 return self
end
return Menu
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="152">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>