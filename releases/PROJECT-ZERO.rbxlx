      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">AnimationPose</string>
          <string name="Source"><![CDATA[-- Original R15 preview/gameplay placeholder animation, no external clip dependency.
local Pose = {}
function Pose.apply(m,time,speed,action,progress)
	local hero=m:GetAttribute("Hero")
	local wave=math.sin(time*10)*math.clamp(speed,0,1)*.5
	local recoil=if action=="Fire" then math.max(0,1-progress)*.18 else 0
	local reload=if action=="Reload" then math.sin(math.clamp(progress,0,1)*math.pi) else 0
	for _,j in m:GetDescendants() do if j:IsA("Motor6D") then
		-- Store the bind pose on the joint. Weak Instance-key caches can lose their
		-- Lua wrappers during GC and accidentally capture an already animated C0.
		local base=j:GetAttribute("ZeroBindC0")
		if not base then base=j.C0 j:SetAttribute("ZeroBindC0",base) end
		local name=j.Name
		if name=="RightUpperLegJoint" then j.C0=base*CFrame.Angles(wave,0,0)
		elseif name=="LeftUpperLegJoint" then j.C0=base*CFrame.Angles(-wave,0,0)
		elseif name=="RightUpperArmJoint" then
			local pitch=if hero=="ATLAS" then .4 elseif hero=="TITAN" then 1 else 1.05
			j.C0=base*CFrame.Angles(pitch+recoil-reload*.7,0,-.1-reload*.25)
		elseif name=="LeftUpperArmJoint" then
			local pitch=if hero=="PHANTOM" then 1.05 elseif hero=="ATLAS" then .4 else .85
			j.C0=base*CFrame.Angles(pitch+recoil+reload*.4,0,if hero=="PHANTOM" or hero=="ATLAS" then .1 else .75)
		elseif name=="RightLowerArmJoint" or name=="LeftLowerArmJoint" then j.C0=base*CFrame.Angles(.25+reload*.5,0,0)
		elseif name=="UpperTorsoJoint" then j.C0=base*CFrame.Angles(0,math.sin(time*1.6)*.015,0)
		elseif name=="HeadJoint" then j.C0=base*CFrame.Angles(.015*math.sin(time*1.4),0,0) end
	end end
end
return Pose
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">ArmorFit</string>
          <string name="Source"><![CDATA[-- Fits reviewed, disconnected rigid armor to individual R15 limbs.
-- No imported joints, scripts, collisions or client-owned hitboxes are used.
local Fit = {}
function Fit.equip(template, model, bodyName, name, size, offset)
	local body = assert(model:FindFirstChild(bodyName), "Missing R15 limb: " .. bodyName)
	local group = template:Clone()
	local provenance=template:GetAttribute("RBX_AI_GENERATION_ID") or template.Parent:GetAttribute("RBX_AI_GENERATION_ID")
	if provenance then group:SetAttribute("ZeroSourceGenerationId",provenance) end
	local center, bounds = group:GetBoundingBox()
	local ratio = size / bounds
	for _,p in group:GetDescendants() do
		if p:IsA("BasePart") then
			local localCF = center:ToObjectSpace(p.CFrame)
			p.Size *= ratio
			local special=p:FindFirstChildOfClass("SpecialMesh")
			if special then special.Scale*=ratio end
			p.CFrame = body.CFrame * offset * CFrame.new(localCF.Position * ratio) * localCF.Rotation
			p.Anchored, p.Massless = false, true
			p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
			p.CastShadow = true
			-- Render/collision fidelity is baked into the template in edit time.
			-- Roblox restricts writes to those properties from gameplay scripts.
			p:SetAttribute("ArmorLimb", bodyName)
			local weld = Instance.new("WeldConstraint")
			weld.Name, weld.Part0, weld.Part1, weld.Parent = "ArmorMount", body, p, p
		end
	end
	group.Name, group.Parent = name, model
	return group
end
return Fit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="103">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- 1 stud = 0.28 metres. All distances and speeds below use Roblox studs.
return table.freeze({
	Hero = "VEX", MaxHealth = 275, WalkSpeed = 22,
	StudsPerMetre = 1 / 0.28,
	Weapon = table.freeze({Name = "VX-7", Damage = 13, HeadMultiplier = 1.5,
		Magazine = 36, ReloadTime = 1.8, FireInterval = 1 / 9, Range = 650}),
	Dash = table.freeze({Speed = 18 / 0.28, Duration = 0.18, Cooldown = 8}),
	RegenDelay = 5, RegenRate = 15, RespawnTime = 8, PreparationTime = 15,
	BotCount = 1, BotThinkInterval = 0.15, BotReactionTime = 0.65, BotSpread = 0.035,
	-- Free Creator Store audio; source and usage notes are in docs/ASSETS.md.
	ShotSound = "rbxassetid://113879008765178",
})
]]></string>
