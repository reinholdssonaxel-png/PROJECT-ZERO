    <Item class="StarterPlayerScripts" referent="46">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">ZeroClient</string>
        </Properties>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Armory</string>
            <string name="Source"><![CDATA[local RunService=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local Catalog=require(game.ReplicatedStorage.ZeroShared.HeroCatalog)
local Factory=require(game.ReplicatedStorage.ZeroShared.RigFactory)
local Pose=require(game.ReplicatedStorage.ZeroShared.AnimationPose)
local Armory={isOpen=false}
function Armory.create(player)
	local gui=Instance.new("ScreenGui") gui.Name="ZeroArmory" gui.IgnoreGuiInset=true gui.ResetOnSpawn=false gui.DisplayOrder=20 gui.Enabled=false gui.Parent=player.PlayerGui
	local bg=Instance.new("Frame") bg.Size=UDim2.fromScale(1,1) bg.BackgroundColor3=Color3.new(1,1,1) bg.BorderSizePixel=0 bg.Parent=gui
	local grad=Instance.new("UIGradient") grad.Color=ColorSequence.new(Color3.fromRGB(12,20,29),Color3.fromRGB(35,53,68)) grad.Rotation=30 grad.Parent=bg
	local function label(text,pos,size,color,fontSize)
		local l=Instance.new("TextLabel") l.Text=text l.Position=pos l.Size=size l.BackgroundTransparency=1 l.TextColor3=color or Color3.fromRGB(220,231,238) l.Font=Enum.Font.GothamBold l.TextScaled=true l.TextXAlignment=Enum.TextXAlignment.Left l.Parent=bg
		local limit=Instance.new("UITextSizeConstraint") limit.MaxTextSize=fontSize or 24 limit.MinTextSize=9 limit.Parent=l
		return l
	end
	local function button(text,pos,size,callback)
		local b=Instance.new("TextButton") b.Text=text b.Position=pos b.Size=size b.BackgroundColor3=Color3.fromRGB(38,56,70) b.BorderSizePixel=0 b.TextColor3=Color3.fromRGB(217,230,238) b.Font=Enum.Font.GothamBold b.TextScaled=true b.Parent=bg
		local limit=Instance.new("UITextSizeConstraint") limit.MaxTextSize=17 limit.Parent=b
		b.Activated:Connect(callback)
		return b
	end
	label("ZERO // OPERATIVE ARCHIVE",UDim2.fromScale(.04,.04),UDim2.fromScale(.7,.055),nil,30)
	label("NORRHAMN 2042  /  EIGHT HUMAN OPERATIVES",UDim2.fromScale(.04,.105),UDim2.fromScale(.7,.035),Color3.fromRGB(103,180,208),13)
	local viewport=Instance.new("ViewportFrame") viewport.Name="HeroPreview" viewport.Position=UDim2.fromScale(.31,.15) viewport.Size=UDim2.fromScale(.36,.78) viewport.BackgroundTransparency=1 viewport.Ambient=Color3.fromRGB(163,177,196) viewport.LightColor=Color3.fromRGB(250,228,207) viewport.LightDirection=Vector3.new(-1,-1,-2) viewport.Parent=bg
	local world=Instance.new("WorldModel") world.Parent=viewport
	local camera=Instance.new("Camera") camera.FieldOfView=35 camera.CFrame=CFrame.lookAt(Vector3.new(7,4.8,-12),Vector3.new(0,2.8,0)) camera.Parent=viewport viewport.CurrentCamera=camera
	local name=label("VEX",UDim2.fromScale(.69,.25),UDim2.fromScale(.28,.09),nil,48)
	local role=label("",UDim2.fromScale(.69,.35),UDim2.fromScale(.27,.04),nil,18)
	local identity=label("",UDim2.fromScale(.69,.42),UDim2.fromScale(.27,.07),nil,18)
	local weapon=label("",UDim2.fromScale(.69,.51),UDim2.fromScale(.27,.06),nil,18)
	local silhouette=label("",UDim2.fromScale(.69,.59),UDim2.fromScale(.27,.08),nil,15)
	local status=label("",UDim2.fromScale(.69,.7),UDim2.fromScale(.27,.11),nil,14)
	local preview,selected,action,actionAt="","VEX","Idle",0
	local cards={}
	local function choose(id)
		local h=Catalog.Heroes[id]
		local nextPreview=Factory.create(id.."_Preview","Alpha",Vector3.zero,id)
		if typeof(preview)=="Instance" then preview:Destroy() end
		preview=nextPreview selected=id gui:SetAttribute("SelectedHero",id)
		for _,p in preview:GetDescendants() do if p:IsA("BasePart") then p.Anchored=p.Name=="HumanoidRootPart" p.CanCollide=false end end
		preview.Parent=world
		name.Text,role.Text,identity.Text=id,string.upper(h.Role).."  /  "..h.HP.." HP",h.Name.."\n"..h.Origin
		name.TextColor3,role.TextColor3=h.Accent,h.Accent
		weapon.Text,silhouette.Text=h.Weapon,h.Silhouette
		status.Text=if h.Playable then "VEX: PLAYABLE\nDash available / grenade + ultimate pending" else "VISUAL PROTOTYPE\nWeapon and animation previews ready\nGameplay kit remains locked"
		status.TextColor3=if h.Playable then Color3.fromRGB(110,222,193) else Color3.fromRGB(230,177,109)
		for key,b in cards do b.BackgroundColor3=if key==id then h.Primary else Color3.fromRGB(30,44,57) end
	end
	for i,id in Catalog.Order do
		local h=Catalog.Heroes[id]
		cards[id]=button(id.."  /  "..string.upper(h.Role)..(if h.Playable then "" else "  [PREVIEW]"),UDim2.fromScale(.04,.19+(i-1)*.083),UDim2.fromScale(.25,.065),function() choose(id) end)
		cards[id].Name="Hero_"..id
	end
	for i,a in {"Idle","Run","Fire","Reload"} do
		local b=button(a,UDim2.fromScale(.32+(i-1)*.085,.91),UDim2.fromScale(.078,.04),function() action=a actionAt=os.clock() gui:SetAttribute("PreviewAction",a) end)
		b.Name="Pose_"..a
	end
	local function close()
		Armory.isOpen=false gui.Enabled=false
		workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
		player.CameraMode=Enum.CameraMode.LockFirstPerson
		UIS.MouseIconEnabled=false
	end
	button("RETURN TO VEX  /  H",UDim2.fromScale(.69,.87),UDim2.fromScale(.27,.065),close)
	label("Visual previews do not unlock unimplemented kits.",UDim2.fromScale(.04,.94),UDim2.fromScale(.26,.025),Color3.fromRGB(132,152,167),11)
	UIS.InputBegan:Connect(function(input,processed)
		if processed or input.KeyCode~=Enum.KeyCode.H then return end
		if Armory.isOpen then close() else
			Armory.isOpen=true gui.Enabled=true workspace.CurrentCamera.CameraType=Enum.CameraType.Scriptable UIS.MouseIconEnabled=true UIS.MouseBehavior=Enum.MouseBehavior.Default
		end
	end)
	player.CharacterAdded:Connect(function() if Armory.isOpen then close() end end)
	RunService:BindToRenderStep("ZeroArmory",Enum.RenderPriority.Camera.Value+3,function()
		if not Armory.isOpen then return end
		UIS.MouseBehavior=Enum.MouseBehavior.Default UIS.MouseIconEnabled=true
		local elapsed=os.clock()-actionAt
		local progress=if action=="Reload" then (elapsed%2.5)/1.8 elseif action=="Fire" then (elapsed%(.5))/.2 else 0
		Pose.apply(preview,os.clock(),if action=="Run" then 1 else 0,action,progress)
		preview.HumanoidRootPart.CFrame=CFrame.new(0,3.1,0)*CFrame.Angles(0,math.sin(os.clock()*.18)*.18,0)
	end)
	choose("VEX")
	return Armory
end
return Armory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[local Hud = {}
local WHITE, CYAN, ORANGE = Color3.fromRGB(226, 238, 244), Color3.fromRGB(74, 216, 241), Color3.fromRGB(255, 148, 65)
function Hud.create(player)
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "ZeroHUD", false, true
	gui.Parent = player:WaitForChild("PlayerGui")
	local function label(name, text, pos, size, fontSize, color, align)
		local t = Instance.new("TextLabel")
		t.Name, t.Text = name, text
		t.Position, t.Size = pos, size
		t.BackgroundTransparency, t.TextColor3 = 1, color or WHITE
		t.TextSize, t.Font = fontSize, Enum.Font.GothamBold
		t.TextXAlignment = align or Enum.TextXAlignment.Left
		t.Parent = gui
		return t
	end
	local function panel(pos, size)
		local p = Instance.new("Frame")
		p.Position, p.Size = pos, size
		p.BackgroundColor3, p.BackgroundTransparency, p.BorderSizePixel = Color3.fromRGB(13, 22, 30), .15, 0
		p.Parent = gui
		local line = Instance.new("Frame") line.Size = UDim2.new(1, 0, 0, 2) line.BackgroundColor3 = CYAN line.BorderSizePixel = 0 line.Parent = p
		return p
	end
	panel(UDim2.new(0, 28, 1, -134), UDim2.fromOffset(255, 105))
	panel(UDim2.new(1, -255, 1, -134), UDim2.fromOffset(227, 105))
	label("Brand", "PROJECT: ZERO", UDim2.fromOffset(28, 30), UDim2.fromOffset(260, 32), 25)
	label("Build", "2042  /  ZERO INITIATIVE  /  H: ARMORY", UDim2.fromOffset(30, 64), UDim2.fromOffset(330, 20), 11, CYAN)
	label("Map", "HAMNVERKET", UDim2.new(1, -280, 0, 32), UDim2.fromOffset(250, 30), 21, WHITE, Enum.TextXAlignment.Right)
	label("Location", "NORRHAMN  /  20:30", UDim2.new(1, -280, 0, 64), UDim2.fromOffset(250, 20), 11, CYAN, Enum.TextXAlignment.Right)
	local phase = label("Phase", "PREPARE", UDim2.new(.5, -220, 0, 35), UDim2.fromOffset(440, 32), 19, ORANGE, Enum.TextXAlignment.Center)
	local info = label("Info", "TRAINING DEATHMATCH", UDim2.new(.5, -240, 0, 70), UDim2.fromOffset(480, 20), 11, WHITE, Enum.TextXAlignment.Center)
	label("Hero", "VEX  /  DAMAGE", UDim2.new(0, 46, 1, -122), UDim2.fromOffset(220, 22), 14, CYAN)
	local health = label("Health", "275", UDim2.new(0, 46, 1, -97), UDim2.fromOffset(115, 43), 37)
	label("MaxHealth", "/ 275 HP", UDim2.new(0, 142, 1, -82), UDim2.fromOffset(120, 22), 13)
	local healthBg = Instance.new("Frame") healthBg.Position = UDim2.new(0, 46, 1, -48) healthBg.Size = UDim2.fromOffset(218, 6) healthBg.BackgroundColor3 = Color3.fromRGB(45, 64, 73) healthBg.BorderSizePixel = 0 healthBg.Parent = gui
	local healthBar = Instance.new("Frame") healthBar.Size = UDim2.fromScale(1, 1) healthBar.BackgroundColor3 = CYAN healthBar.BorderSizePixel = 0 healthBar.Parent = healthBg
	label("Weapon", "VX-7  /  ASSAULT RIFLE", UDim2.new(1, -237, 1, -122), UDim2.fromOffset(200, 22), 12, ORANGE)
	local ammo = label("Ammo", "36", UDim2.new(1, -237, 1, -97), UDim2.fromOffset(110, 43), 37)
	label("MaxAmmo", "/ 36", UDim2.new(1, -142, 1, -82), UDim2.fromOffset(75, 22), 16)
	local reload = label("Reload", "R  RELOAD", UDim2.new(1, -237, 1, -51), UDim2.fromOffset(200, 18), 11, ORANGE)
	local dash = label("Dash", "Q  DASH  /  READY", UDim2.new(.5, -150, 1, -89), UDim2.fromOffset(300, 28), 17, CYAN, Enum.TextXAlignment.Center)
	label("FutureAbilities", "PULSE GRENADE  /  OVERDRIVE  [LOCKED]", UDim2.new(.5, -210, 1, -57), UDim2.fromOffset(420, 18), 10, Color3.fromRGB(143, 159, 171), Enum.TextXAlignment.Center)
	label("Controls", "WASD  MOVE     MOUSE  AIM / FIRE     SPACE  JUMP", UDim2.new(.5, -260, 1, -29), UDim2.fromOffset(520, 16), 10, WHITE, Enum.TextXAlignment.Center)
	local crosshair = Instance.new("Frame") crosshair.Name = "Crosshair" crosshair.Size = UDim2.fromOffset(2, 2) crosshair.Position = UDim2.fromScale(.5, .5) crosshair.BackgroundTransparency = 1 crosshair.Parent = gui
	for _, data in {{-12, 0, 7, 2}, {6, 0, 7, 2}, {0, -12, 2, 7}, {0, 6, 2, 7}} do
		local line = Instance.new("Frame") line.Position = UDim2.fromOffset(data[1], data[2]) line.Size = UDim2.fromOffset(data[3], data[4]) line.BorderSizePixel = 0 line.BackgroundColor3 = WHITE line.Parent = crosshair
	end
	local hit = label("Hit", "×", UDim2.new(.5, -20, .5, -20), UDim2.fromOffset(40, 40), 36, ORANGE, Enum.TextXAlignment.Center) hit.Visible = false
	local death = label("Death", "", UDim2.new(.5, -300, .5, 60), UDim2.fromOffset(600, 70), 24, ORANGE, Enum.TextXAlignment.Center)
	return {gui = gui, health = health, healthBar = healthBar, ammo = ammo, reload = reload, dash = dash, phase = phase, info = info, hit = hit, death = death}
end
return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="50">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local C = require(game.ReplicatedStorage.ZeroShared.Config)
local G = require(game.ReplicatedStorage.ZeroShared.Geometry)
local Hud = require(script.Parent.Hud)
local player = Players.LocalPlayer
local remotes = game.ReplicatedStorage:WaitForChild("ZeroRemotes")
local hud = Hud.create(player)
local armory = require(script.Parent.Armory).create(player)
local Pose = require(game.ReplicatedStorage.ZeroShared.AnimationPose)
local character, humanoid, viewmodel
local ammo, localReloadEnd, nextShot, recoil, hitUntil = 36, 0, 0, 0, 0
local holding = false
local shotSound = Instance.new("Sound") shotSound.SoundId = C.ShotSound shotSound.Volume = .35 shotSound.Parent = SoundService
local tickSound = Instance.new("Sound") tickSound.SoundId = "rbxasset://sounds/button.wav" tickSound.Volume = .15 tickSound.Parent = SoundService
workspace:GetAttributeChangedSignal("ZeroPhase"):Connect(function() tickSound:Play() end)
local fxFolder = Instance.new("Folder") fxFolder.Name = "ZeroLocalFX" fxFolder.Parent = workspace
local visualShots = setmetatable({}, {__mode = "k"})
local function makeViewmodel()
	if viewmodel then viewmodel:Destroy() end
	viewmodel = Instance.new("Model") viewmodel.Name = "VEX_FirstPerson"
	local root = G.part(viewmodel, "Root", Vector3.one * .1, CFrame.identity, Color3.new()) root.Transparency = 1
	viewmodel.PrimaryPart = root
	local rifle = G.rifle(viewmodel)
	rifle:PivotTo(CFrame.new(.62, -.5, -1.1))
	G.part(viewmodel, "RightGlove", Vector3.new(.33, .35, .48), CFrame.new(.63, -.83, -.7), Color3.fromRGB(29, 34, 41))
	G.part(viewmodel, "RightArm", Vector3.new(.38, .4, 1.15), CFrame.new(.68, -.92, -.05) * CFrame.Angles(-.15, 0, 0), Color3.fromRGB(48, 55, 64))
	G.part(viewmodel, "LeftArm", Vector3.new(.38, .4, 1.25), CFrame.new(.05, -.89, -1.04) * CFrame.Angles(-.2, -.8, -.15), Color3.fromRGB(48, 55, 64))
	for _, p in viewmodel:GetDescendants() do
		if p:IsA("BasePart") then p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false end
	end
	viewmodel.Parent = workspace.CurrentCamera
end
local ammoConnection
local function attach(m)
	character = m humanoid = m:WaitForChild("Humanoid")
	workspace.CurrentCamera.CameraSubject = humanoid
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	workspace.CurrentCamera.FieldOfView = 80
	local root = m:WaitForChild("HumanoidRootPart")
	workspace.CurrentCamera.CFrame = CFrame.lookAt(m.Head.Position, m.Head.Position + root.CFrame.LookVector * 30)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	UserInputService.MouseIconEnabled = false
	ammo, localReloadEnd, nextShot, recoil, holding = m:GetAttribute("Ammo") or 36, 0, 0, 0, false
	if ammoConnection then ammoConnection:Disconnect() end
	ammoConnection = m:GetAttributeChangedSignal("Ammo"):Connect(function() ammo = m:GetAttribute("Ammo") or 0 end)
	makeViewmodel()
end
player.CharacterAdded:Connect(attach)
if player.Character then task.spawn(attach, player.Character) end
local function reload()
	if not humanoid or humanoid.Health <= 0 or ammo == 36 or workspace:GetServerTimeNow() < localReloadEnd then return end
	localReloadEnd = workspace:GetServerTimeNow() + C.Weapon.ReloadTime
	remotes.Action:FireServer("Reload")
	tickSound:Play()
end
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or armory.isOpen then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then holding = true
	elseif input.KeyCode == Enum.KeyCode.R then reload()
	elseif input.KeyCode == Enum.KeyCode.Q and humanoid and humanoid.Health > 0 then
		local d = humanoid.MoveDirection
		if d.Magnitude < .1 then d = workspace.CurrentCamera.CFrame.LookVector end
		remotes.Action:FireServer("Dash", d.Unit)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then holding = false end
end)
UserInputService.WindowFocusReleased:Connect(function() holding = false end)
local function tracer(origin, endpoint, color)
	local delta = endpoint - origin
	if delta.Magnitude < .05 then return end
	local p = G.part(fxFolder, "Tracer", Vector3.new(.035, .035, delta.Magnitude), CFrame.lookAt((origin + endpoint) / 2, endpoint), color, Enum.Material.Neon)
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	Debris:AddItem(p, .055)
	local impact = G.part(fxFolder, "Impact", Vector3.one * .16, CFrame.new(endpoint), color, Enum.Material.Neon)
	impact.CanCollide, impact.CanQuery, impact.CanTouch = false, false, false
	Debris:AddItem(impact, .1)
end
remotes.FX.OnClientEvent:Connect(function(shooter, origin, endpoint, hit, headshot, killed)
	if shooter then visualShots[shooter] = os.clock() end
	tracer(origin, endpoint, if shooter == character then Color3.fromRGB(255, 173, 73) else Color3.fromRGB(255, 83, 48))
	if shooter == character then
		if hit then
			hitUntil = os.clock() + .16
			hud.hit.TextColor3 = if killed then Color3.fromRGB(255, 58, 63) elseif headshot then Color3.fromRGB(255, 178, 55) else Color3.new(1, 1, 1)
			tickSound:Play()
		end
	elseif shooter and shooter:FindFirstChild("Head") then
		local sound = shotSound:Clone() sound.Volume = .2 sound.RollOffMaxDistance = 220 sound.Parent = shooter.Head sound:Play() Debris:AddItem(sound, 2)
	end
end)
RunService:BindToRenderStep("ZeroFPS", Enum.RenderPriority.Camera.Value + 1, function(dt)
	hud.gui.Enabled = not armory.isOpen
	if armory.isOpen then holding = false end
	local time = workspace:GetServerTimeNow()
	local alive = humanoid and humanoid.Health > 0
	local phase = workspace:GetAttribute("ZeroPhase")
	hud.phase.Text = if phase == "PREPARE" then "PREPARE  /  " .. math.max(0, math.ceil((workspace:GetAttribute("ZeroPhaseEnd") or time) - time)) else "TRAINING  /  LIVE"
	hud.info.Text = if phase == "PREPARE" then "VEX ONLINE  •  DOORS OPEN AT ZERO" else "ALPHA vs BRAVO  /  ELIMINATE HOSTILES"
	hud.hit.Visible = os.clock() < hitUntil
	if not character or not humanoid then return end
	hud.health.Text = tostring(math.ceil(humanoid.Health))
	hud.healthBar.Size = UDim2.fromScale(math.clamp(humanoid.Health / C.MaxHealth, 0, 1), 1)
	hud.ammo.Text = string.format("%02d", ammo)
	local serverReload = character:GetAttribute("ReloadEnd") or 0
	local reloading = time < math.max(serverReload, localReloadEnd)
	hud.reload.Text = if reloading then "RELOADING  " .. string.format("%.1f", math.max(serverReload, localReloadEnd) - time) .. "s" else "R  RELOAD"
	local cooldown = math.max(0, (character:GetAttribute("DashReadyAt") or 0) - time)
	hud.dash.Text = if cooldown > 0 then "Q  DASH  /  " .. string.format("%.1fs", cooldown) else "Q  DASH  /  READY"
	local respawnAt = character:GetAttribute("RespawnAt") or time
	hud.death.Text = if not alive then "VEX DOWN\nREDEPLOY IN " .. math.max(0, math.ceil(respawnAt - time)) .. "s" elseif math.abs(character.HumanoidRootPart.Position.Z) >= 100 then "SPAWN PROTECTED" else ""
	if holding and alive and not reloading and phase == "ACTIVE" and time >= nextShot and math.abs(character.HumanoidRootPart.Position.Z) < 100 then
		if ammo > 0 then
			nextShot = time + C.Weapon.FireInterval
			ammo -= 1
			remotes.Action:FireServer("Fire", workspace.CurrentCamera.CFrame.LookVector)
			recoil = math.min(.16, recoil + .045)
			workspace.CurrentCamera.CFrame *= CFrame.Angles(math.rad(.45), 0, 0)
			shotSound.PlaybackSpeed = .96 + math.random() * .08 shotSound:Play()
			local muzzle = viewmodel and viewmodel:FindFirstChild("VX7") and viewmodel.VX7:FindFirstChild("Barrel")
			if muzzle then
				local flash = Instance.new("PointLight") flash.Color = Color3.fromRGB(255, 181, 81) flash.Brightness = 2 flash.Range = 8 flash.Parent = muzzle Debris:AddItem(flash, .04)
			end
		else reload() end
	end
	recoil *= math.exp(-dt * 16)
	if viewmodel then
		viewmodel.Parent = if alive and not armory.isOpen then workspace.CurrentCamera else nil
		local bob = math.sin(os.clock() * 10) * math.min(humanoid.MoveDirection.Magnitude, 1) * .025
		local tilt = if reloading then math.sin(math.clamp(1 - (math.max(serverReload, localReloadEnd) - time) / C.Weapon.ReloadTime, 0, 1) * math.pi) else 0
		viewmodel:PivotTo(workspace.CurrentCamera.CFrame * CFrame.new(0, bob - tilt * .35, recoil) * CFrame.Angles(tilt * -.4, 0, tilt * -.65))
	end
	for _, p in character:GetDescendants() do if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 end end
end)
-- Shared motion poses also drive all eight armory previews.
local gaitClock = 0
RunService.Heartbeat:Connect(function(dt)
	gaitClock += dt
	if gaitClock < .05 then return end
	gaitClock = 0
	for _, m in workspace:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("Hero") and m:FindFirstChild("HumanoidRootPart") then
			local speed = m.HumanoidRootPart.AssemblyLinearVelocity * Vector3.new(1, 0, 1)
			local elapsed = os.clock() - (visualShots[m] or -100)
			local reloadEnd = m:GetAttribute("ReloadEnd") or 0
			local remaining = reloadEnd - workspace:GetServerTimeNow()
			local action = if remaining > 0 then "Reload" elseif elapsed < .2 then "Fire" else "Idle"
			Pose.apply(m, os.clock(), speed.Magnitude / C.WalkSpeed, action, if action == "Reload" then 1 - remaining / C.Weapon.ReloadTime else elapsed / .2)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="51">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>